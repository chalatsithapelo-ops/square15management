  reason                String?   @db.Text
  recipient             String
  raw                   Json?

  @@index([applicationMessageId])
  @@index([event])
}

// ===========================================================================
// Occupational Health & Safety (OHS) Module
// Built around the South African OHS Act 85 of 1993 + Construction Regs 2014.
// All records are auditable, exportable to PDF, and surfaced across portals.
// ===========================================================================

enum OhsDocumentType {
  POLICY // OHS Policy / Health & Safety Policy (Sec 7)
  PROCEDURE // SOP / Safe Work Procedure
  SAFE_WORK_METHOD // Safe Work Method Statement (SWMS)
  RISK_ASSESSMENT // Generic / baseline risk assessment template
  EMERGENCY_PLAN // Emergency Preparedness & Response Plan
  TOOLBOX_TALK // Toolbox talk / safety briefing template
  CHECKLIST // Inspection / pre-task checklist
  MSDS // Material Safety Data Sheet
  PERMIT // Permit-to-work (hot work, confined space, working at heights, etc.)
  TRAINING_MATERIAL // Training / induction materials
  LEGAL_APPOINTMENT // Sec 16(2), 17, 8(2)(i) appointment letters
  OTHER
}

enum OhsRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OhsRiskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OhsIncidentType {
  NEAR_MISS
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME_INJURY // LTI
  FATALITY
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  DANGEROUS_OCCURRENCE // Sec 24
  OCCUPATIONAL_DISEASE
  OTHER
}

enum OhsIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OhsIncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  CORRECTIVE_ACTION
  CLOSED
  REPORTED_TO_DOL // Department of Employment & Labour (Sec 24)
}

enum OhsCorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum OhsTrainingStatus {
  REQUIRED
  SCHEDULED
  COMPLETED
  EXPIRED
}

enum OhsInspectionType {
  DAILY_SITE
  MONTHLY_SITE
  EQUIPMENT
  ELECTRICAL
  FIRE_EQUIPMENT
  FIRST_AID_BOX
  PPE
  VEHICLE
  SCAFFOLD
  OTHER
}

enum OhsInspectionResult {
  PASS
  PASS_WITH_FINDINGS
  FAIL
}

// --- OHS Document Library (policies, procedures, SOPs, MSDS, permits...) ---
model OhsDocument {
  id              Int                  @id @default(autoincrement())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  type            OhsDocumentType
  title           String
  reference       String? // Document reference number (e.g. OHS-POL-001)
  version         String               @default("1.0")
  effectiveDate   DateTime?
  reviewDate      DateTime? // Next mandatory review
  status          OhsRiskStatus        @default(DRAFT)
  // Rich content (markdown / HTML body of the procedure / policy).
  content         String               @db.Text
  // Optional structured sections payload (purpose, scope, responsibilities, definitions, references, procedure steps, records).
  sections        Json?
  // Optional uploaded source PDF (MinIO key).
  sourcePdfUrl    String?
  // Generated/published PDF for download.
  publishedPdfUrl String?
  // Tags for searchability (e.g. "working-at-heights", "electrical").
  tags            String[]             @default([])
  // Owner / scope.
  createdById     Int
  createdBy       User                 @relation("OhsDocumentCreator", fields: [createdById], references: [id])
  contractorId    Int?
  contractor      User?                @relation("OhsDocumentContractor", fields: [contractorId], references: [id])
  // Required acknowledgements?
  requiresAck     Boolean              @default(false)
  // Optional explicit recipients (in addition to role-based targets).
  targetUserIds   Int[]                @default([])
  // Acknowledgement records.
  acks            OhsAcknowledgement[]

  @@index([type])
  @@index([status])
  @@index([contractorId])
}

// --- AI-assisted Risk Assessments ---
model OhsRiskAssessment {
  id               Int             @id @default(autoincrement())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  reference        String?
  title            String
  activity         String // The activity / task being assessed
  location         String?
  status           OhsRiskStatus   @default(DRAFT)
  effectiveDate    DateTime?
  reviewDate       DateTime?
  // Scope linkage (any of these can be null).
  projectId        Int?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId          Int?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientBuildingId Int?
  clientBuilding   ClientBuilding? @relation(fields: [clientBuildingId], references: [id], onDelete: SetNull)
  // Personnel.
  createdById      Int
  createdBy        User            @relation("OhsRiskCreator", fields: [createdById], references: [id])
  approvedById     Int?
  approvedBy       User?           @relation("OhsRiskApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  contractorId     Int?
  contractor       User?           @relation("OhsRiskContractor", fields: [contractorId], references: [id])
  // Overall residual risk after controls.
  overallRisk      OhsRiskLevel    @default(LOW)
  // AI metadata.
  aiGenerated      Boolean         @default(false)
  aiSummary        String?         @db.Text
  aiSuggestions    Json?
  // Items.
  items            OhsRiskItem[]
  // Optional published PDF.
  publishedPdfUrl  String?

  @@index([status])
  @@index([projectId])
  @@index([orderId])
  @@index([contractorId])
}

model OhsRiskItem {
  id                 Int               @id @default(autoincrement())
  createdAt          DateTime          @default(now())
  riskAssessmentId   Int
  riskAssessment     OhsRiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  hazard             String // The hazard
  potentialHarm      String // Who/what may be harmed and how
  inherentLikelihood Int // 1-5
  inherentSeverity   Int // 1-5
  inherentRisk       OhsRiskLevel
  controls           String            @db.Text // Existing + new controls
  responsiblePerson  String?
  residualLikelihood Int // 1-5 after controls
  residualSeverity   Int // 1-5 after controls
  residualRisk       OhsRiskLevel
  ppeRequired        String[]          @default([])
  trainingRequired   String[]          @default([])
  legalReferences    String[]          @default([])
  notes              String?           @db.Text
  aiSuggested        Boolean           @default(false)

  @@index([riskAssessmentId])
}

// --- Incident / Near-miss reporting (Sec 24 of OHS Act) ---
model OhsIncident {
  id                   Int                   @id @default(autoincrement())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  reference            String                @unique // e.g. OHS-INC-00001
  type                 OhsIncidentType
  severity             OhsIncidentSeverity
  status               OhsIncidentStatus     @default(REPORTED)
  occurredAt           DateTime
  reportedAt           DateTime              @default(now())
  location             String
  description          String                @db.Text
  immediateActions     String?               @db.Text
  // Persons involved (free text + optional linked user).
  injuredPersonName    String?
  injuredPersonRole    String?
  injuredPersonContact String?
  injuredUserId        Int?
  injuredUser          User?                 @relation("OhsIncidentInjured", fields: [injuredUserId], references: [id], onDelete: SetNull)
  witnesses            String?               @db.Text
  // Reporter.
  reportedById         Int
  reportedBy           User                  @relation("OhsIncidentReporter", fields: [reportedById], references: [id])
  // Scope / context.
  projectId            Int?
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId              Int?
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientBuildingId     Int?
  clientBuilding       ClientBuilding?       @relation(fields: [clientBuildingId], references: [id], onDelete: SetNull)
  contractorId         Int?
  contractor           User?                 @relation("OhsIncidentContractor", fields: [contractorId], references: [id])
  // Investigation.
  rootCause            String?               @db.Text
  investigationNotes   String?               @db.Text
  // AI suggestion: should this be reported to DoL (Sec 24 OHS Act)?
  dolReportable        Boolean               @default(false)
  // Manual fact: has the DoL notification actually been filed?
  reportedToDol        Boolean               @default(false)
  reportedToDolAt      DateTime?
  reportedToDolBy      String?
  reportedToDolRef     String?
  // AI insights.
  aiInsights           String?               @db.Text
  aiClassification     Json?
  // Photo / document attachments (MinIO keys/urls).
  attachments          String[]              @default([])
  // Generated PDF.
  publishedPdfUrl      String?
  // Corrective actions.
  correctiveActions    OhsCorrectiveAction[]

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([projectId])
  @@index([orderId])
  @@index([occurredAt])
}

model OhsCorrectiveAction {
  id            Int                       @id @default(autoincrement())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  incidentId    Int?
  incident      OhsIncident?              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  description   String                    @db.Text
  responsibleId Int
  responsible   User                      @relation("OhsCorrectiveResponsible", fields: [responsibleId], references: [id])
  dueDate       DateTime
  status        OhsCorrectiveActionStatus @default(OPEN)
  completedAt   DateTime?
  verifiedById  Int?
  verifiedBy    User?                     @relation("OhsCorrectiveVerifier", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  evidenceUrl   String?

  @@index([incidentId])
  @@index([status])
  @@index([responsibleId])
}

// --- Toolbox Talks ---
model OhsToolboxTalk {
  id              Int                  @id @default(autoincrement())
  createdAt       DateTime             @default(now())
  publishedAt     DateTime?
  reference       String?
  title           String
  topic           String
  content         String               @db.Text
  // Target audience (roles).
  targetRoles     String[]             @default([])
  // Optional scope.
  projectId       Int?
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId         Int?
  order           Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contractorId    Int?
  contractor      User?                @relation("OhsToolboxContractor", fields: [contractorId], references: [id])
  createdById     Int
  createdBy       User                 @relation("OhsToolboxCreator", fields: [createdById], references: [id])
  status          OhsRiskStatus        @default(DRAFT)
  ackDeadline     DateTime?
  publishedPdfUrl String?
  // Optional explicit recipients (in addition to role-based targets). Used to send a talk to specific artisans.
  targetUserIds   Int[]                @default([])
  acks            OhsAcknowledgement[]

  @@index([status])
  @@index([projectId])
}

// --- Generic acknowledgement record (works for documents, toolbox talks, etc.) ---
model OhsAcknowledgement {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now())
  userId         Int
  user           User            @relation("OhsAck", fields: [userId], references: [id], onDelete: Cascade)
  documentId     Int?
  document       OhsDocument?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  toolboxTalkId  Int?
  toolboxTalk    OhsToolboxTalk? @relation(fields: [toolboxTalkId], references: [id], onDelete: Cascade)
  ackedAt        DateTime        @default(now())
  signatureText  String?
  // Drawn signature captured on the device (data URL, base64-encoded PNG).
  signatureImage String?         @db.Text
  ipAddress      String?
  userAgent      String?

  @@unique([userId, documentId])
  @@unique([userId, toolboxTalkId])
  @@index([userId])
  @@index([documentId])
  @@index([toolboxTalkId])
}

// --- Training records (legal requirement: induction, working at heights, first aid, fire fighter, etc.) ---
model OhsTrainingRecord {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         Int
  user           User              @relation("OhsTraining", fields: [userId], references: [id], onDelete: Cascade)
  course         String
  provider       String?
  competency     String?
  status         OhsTrainingStatus @default(REQUIRED)
  completedAt    DateTime?
  expiresAt      DateTime?
  certificateUrl String?
  notes          String?

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// --- Inspections ---
model OhsInspection {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())
  type             OhsInspectionType
  reference        String?
  performedAt      DateTime
  performedById    Int
  performedBy      User                @relation("OhsInspector", fields: [performedById], references: [id])
  location         String?
  projectId        Int?
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId          Int?
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientBuildingId Int?
  clientBuilding   ClientBuilding?     @relation(fields: [clientBuildingId], references: [id], onDelete: SetNull)
  contractorId     Int?
  contractor       User?               @relation("OhsInspectionContractor", fields: [contractorId], references: [id])
  result           OhsInspectionResult @default(PASS)
  findings         Json?
  notes            String?             @db.Text
  publishedPdfUrl  String?

  @@index([type])
  @@index([performedAt])
  @@index([projectId])
}

// --- PPE issue register ---
model OhsPpeIssue {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  userId         Int
  user           User      @relation("OhsPpeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  itemName       String
  size           String?
  quantity       Int       @default(1)
  issuedAt       DateTime  @default(now())
  issuedById     Int
  issuedBy       User      @relation("OhsPpeIssuer", fields: [issuedById], references: [id])
  replacementDue DateTime?
  signature      String? // signed acknowledgement text
  notes          String?

  @@index([userId])
  @@index([issuedAt])
}

// ============================================================================
// PR-4 � PM CONTRACTOR COMPLIANCE HUB
// ============================================================================

// PM-customisable compliance requirements per PM.
// Each PM can define which documents they want to track for their contractors,
// with optional weight + per-service-type filters.
model PmComplianceRequirement {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyManagerId Int
  propertyManager   User @relation("PmComplianceRequirementOwner", fields: [propertyManagerId], references: [id], onDelete: Cascade)

  documentType      DocumentType // matches ContractorDocument.documentType OR is OTHER for free-form
  customLabel       String? // e.g. "Work at Heights Certificate" (used when documentType=OTHER)
  weight            Int          @default(10) // 1..100, used in scoring
  isMandatory       Boolean      @default(true)
  serviceTypeFilter String? // null = applies to all, else only this service type
  notes             String?
  isActive          Boolean      @default(true)

  @@unique([propertyManagerId, documentType, customLabel])
  @@index([propertyManagerId])
}

// Cached compliance score per contractor (computed by nightly cron + on demand).
model ContractorComplianceScore {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractorId Int        @unique
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  propertyManagerId Int?

  score     Int            @default(0) // 0-100
  band      ComplianceBand @default(RED)
  breakdown Json // array of {requirement, status, weight, points}

  missingCount           Int @default(0)
  expiredCount           Int @default(0)
  expiringCount30d       Int @default(0)
  expiringCount7d        Int @default(0)
  incidentsLast12mo      Int @default(0)
  majorIncidentsLast12mo Int @default(0)
  ssraCompletedJobs      Int @default(0)
  totalJobsLast90d       Int @default(0)

  previousScore Int?
  previousBand  ComplianceBand?
  computedAt    DateTime        @default(now())

  @@index([propertyManagerId])
  @@index([band])
  @@index([score])
}

// ============================================================================
// PR-5 — TENANT INSPECTION REPORT (Ingoing / Outgoing)
// ============================================================================

// Reusable inspection room+item templates.
// System ships with defaults (propertyManagerId=NULL); each PM can add their own.
model InspectionTemplate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyManagerId Int? // NULL = global system template
  owner             User? @relation("InspectionTemplateOwner", fields: [propertyManagerId], references: [id], onDelete: Cascade)

  name         String // "Standard 2-bed apartment"
  description  String?
  buildingType String? // RESIDENTIAL | COMMERCIAL | INDUSTRIAL — optional filter
  isDefault    Boolean @default(false)

  // Shape: [{ name, type, displayOrder, items: [{ name, category }] }]
  rooms Json

  @@index([propertyManagerId])
}

model TenantInspection {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionNumber String @unique // INSP-2026-0001

  type   InspectionType
  status InspectionStatus @default(DRAFT)

  // Property
  buildingId Int
  building   Building @relation("BuildingInspections", fields: [buildingId], references: [id])
  unitNumber String?

  // Tenant
  tenantName     String
  tenantIdNumber String?
  tenantEmail    String
  tenantPhone    String?

  // Ownership
  propertyManagerId Int
  propertyManager   User  @relation("InspectionPropertyManager", fields: [propertyManagerId], references: [id])
  conductedById     Int?
  conductedBy       User? @relation("InspectionConductor", fields: [conductedById], references: [id], onDelete: SetNull)

  // Schedule
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  // General data
  generalNotes      String? @db.Text
  weatherConditions String?
  meterReadings     Json? // {electricity, water, gas}
  keyHandover       Json? // {frontDoor:2, garage:1, ...}

  // Outgoing inspection pairing
  linkedIngoingId    Int?              @unique
  linkedIngoing      TenantInspection? @relation("InspectionPair", fields: [linkedIngoingId], references: [id], onDelete: SetNull)
  outgoingForIngoing TenantInspection? @relation("InspectionPair")

  // Sign-offs
  tenantSignatureUrl   String?
  tenantSignedAt       DateTime?
  tenantSignatureToken String?   @unique
  tenantTokenExpiresAt DateTime?
  pmSignatureUrl       String?
  pmSignedAt           DateTime?
  witnessSignatureUrl  String?
  witnessName          String?

  // Outputs
  pdfReportUrl String?

  // Damage assessment (mostly outgoing)
  totalDamageCost Float?
  depositAmount   Float?
  depositDeducted Float?
  depositRefunded Float?
  tenantDisputed  Boolean @default(false)
  disputeNotes    String? @db.Text

  rooms TenantInspectionRoom[]

  @@index([propertyManagerId])
  @@index([buildingId])
  @@index([status])
  @@index([type])
  @@index([scheduledFor])
}

model TenantInspectionRoom {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  inspectionId Int
  inspection   TenantInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  roomName     String // "Master Bedroom"
  roomType     String // BEDROOM | BATHROOM | KITCHEN | LIVING | EXTERIOR | GARAGE | OTHER
  displayOrder Int    @default(0)

  overallCondition ConditionRating @default(NOT_APPLICABLE)
  notes            String?         @db.Text

  items TenantInspectionItem[]

  @@index([inspectionId])
}

model TenantInspectionItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  roomId Int
  room   TenantInspectionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  itemName     String // "Walls", "Ceiling", "Light fitting", "Geyser"
  category     String? // STRUCTURE | FIXTURES | APPLIANCES | SERVICES | FINISHES
  displayOrder Int     @default(0)

  condition     ConditionRating @default(NOT_APPLICABLE)
  isPreExisting Boolean         @default(false)
  isNewDamage   Boolean         @default(false)
  notes         String?         @db.Text
  photoUrls     String[]        @default([])

  // Damage costing (outgoing)
  repairRequired      Boolean @default(false)
  estimatedRepairCost Float?
  tenantLiable        Boolean @default(false)

  // For comparison with ingoing
  ingoingItemId Int?

  @@index([roomId])
  @@index([ingoingItemId])
}


model WageReportRecipient {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation("WageRecipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model WageReportRun {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  sentCount     Int      @default(0)
  skippedCount  Int      @default(0)

  @@unique([periodStart, periodEnd])
}

model ScreeningQuestion {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  jobId             Int
  job               Job      @relation("JobScreeningQuestions", fields: [jobId], references: [id], onDelete: Cascade)
  questionText      String   @db.Text
  questionType      String   // YES_NO | NUMBER | SELECT
  required          Boolean  @default(true)
  displayOrder      Int      @default(0)

  knockoutEnabled   Boolean  @default(true)
  expectedYesNo     String?  // "YES" or "NO"
  minNumber         Float?
  maxNumber         Float?
  acceptableOptions String[] @default([])
  options           String[] @default([])

  answers           ScreeningAnswer[]

  @@index([jobId])
}

model ScreeningAnswer {
  id            Int              @id @default(autoincrement())
  createdAt     DateTime         @default(now())
  applicationId Int
  application   Application      @relation("ApplicationScreeningAnswers", fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText    String?
  answerNumber  Float?
  passed        Boolean          @default(true)

  @@index([applicationId])
  @@index([questionId])
}

// External work-order sync from myBuildings (Eris / Core Vision platform) and manual entry
model ClientWorkOrder {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  source             String   @default("MYBUILDINGS")  // MYBUILDINGS | MANUAL
  externalJobCode    String?
  externalId         Int?
  externalStatusId   Int?
  externalStatusName String?
  externalSite       String?

  title              String?
  description        String?  @db.Text
  priority           String?
  requestedAt        DateTime?
  requiredBy         DateTime?
  approvedAmount     Float?

  ourStatus          String   @default("NEW")
  assignedToUserId   Int?
  assignedToUser     User?    @relation("ClientWorkOrderAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  internalNotes      String?  @db.Text

  linkedInvoiceId    Int?
  linkedInvoice      Invoice? @relation("ClientWorkOrderInvoice", fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  linkedClientId     Int?
  linkedClient       Client?  @relation("ClientWorkOrderClient", fields: [linkedClientId], references: [id], onDelete: SetNull)

  lastPushAt         DateTime?
  lastPushError      String?
  pushedStatusId     Int?
  pushedInvoiceAt    DateTime?
  pushedAttachmentAt DateTime?

  rawPayload         Json?

  syncLogs           MyBuildingsSyncLog[]

  linkedOrders       Order[] @relation("ClientWorkOrderOrders")
  linkedBuildingId   Int?
  linkedBuilding     ClientBuilding? @relation("ClientWorkOrderBuilding", fields: [linkedBuildingId], references: [id], onDelete: SetNull)

  @@unique([source, externalJobCode], name: "source_jobCode")
  @@index([source, externalId])
  @@index([ourStatus])
  @@index([assignedToUserId])
  @@index([linkedInvoiceId])
}

model MyBuildingsSyncLog {
  id                Int              @id @default(autoincrement())
  createdAt         DateTime         @default(now())
  clientWorkOrderId Int?
  clientWorkOrder   ClientWorkOrder? @relation(fields: [clientWorkOrderId], references: [id], onDelete: SetNull)
  direction         String
  operation         String
  externalRef       String?
  statusCode        Int?
  success           Boolean          @default(false)
  errorMessage      String?          @db.Text
  requestBody       Json?
  responseBody      Json?

  @@index([direction, operation])
  @@index([createdAt])
  @@index([clientWorkOrderId])
}

model MyBuildingsInvoicePublicToken {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  invoiceId Int
  invoice   Invoice  @relation("InvoicePublicToken", fields: [invoiceId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  usedCount Int      @default(0)

  @@index([invoiceId])
}

model ClientWorkOrderSiteMapping {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source            String   @default("MYBUILDINGS")  // MYBUILDINGS | OTHER
  externalSite      String   // Free-text site name coming from Eris, e.g. "102 Rivonia Rd - B"
  externalCode      String?  // Building code if provided (e.g. "RV01")

  linkedBuildingId  Int?
  linkedBuilding    ClientBuilding? @relation("SiteMappingBuilding", fields: [linkedBuildingId], references: [id], onDelete: SetNull)
  linkedClientId    Int?
  linkedClient      Client?         @relation("SiteMappingClient", fields: [linkedClientId], references: [id], onDelete: SetNull)

  notes             String?  @db.Text
  autoLinkedCount   Int      @default(0)

  @@unique([source, externalSite], name: "source_externalSite")
  @@index([externalCode])
}model FinanceAuditFix {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  category  String
  entity    String
  entityId  Int?
  action    String
  before    Json?
  after     Json?
  fixedBy   String   @default("auto-audit")
  @@index([category])
  @@index([entity, entityId])
}model DebtorReminderLog {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  thresholdDays Int
  recipient     String
  status        String   @default("SENT")
  sentAt        DateTime?
  errorMessage  String?  @db.Text
  @@unique([invoiceId, thresholdDays])
  @@index([sentAt])
}model VatReconciliationRun {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  periodStart          DateTime
  periodEnd            DateTime
  outputVat            Float    @default(0)
  inputVat             Float    @default(0)
  estimatedPayable     Float    @default(0)
  invoiceVatMismatch   Int      @default(0)
  invoiceVatVariance   Float    @default(0)
  invoiceLineMismatch  Int      @default(0)
  invoiceLineVariance  Float    @default(0)
  expensesMissingVat   Int      @default(0)
  expensesPotentialVat Float    @default(0)
  details              Json?
  runBy                String   @default("scheduler")
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}model ArtisanPaymentStatement {
  id                Int            @id @default(autoincrement())
  createdAt         DateTime       @default(now())
  statementNumber   String         @unique
  paymentRequestId  Int            @unique
  paymentRequest    PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  artisanId         Int
  paymentDate       DateTime
  grossAmount       Float
  withholdingAmount Float          @default(0)
  netAmount         Float
  classification    String         @default("INDEPENDENT_CONTRACTOR")
  emailedAt         DateTime?
  notes             String?
  @@index([artisanId, paymentDate])
}

model MyBuildingsJobCardPublicToken {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  orderId   Int
  order     Order    @relation("OrderJobCardPublicToken", fields: [orderId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  usedCount Int      @default(0)

  @@index([orderId])
}
