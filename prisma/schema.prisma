}

// PR-6 — Multi-artisan crew on a single Order.
// One Order has 1 LEAD + 0..N CREW. Rates are snapshotted at join time so
// future changes to the User's rate don't retroactively alter completed-job costs.
model OrderCrew {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("OrderCrewMember", fields: [userId], references: [id])

  role String // "LEAD" | "CREW"

  // Snapshot at join time
  hourlyRate Float?
  dailyRate  Float?

  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  ssraAckedAt DateTime?

  // Anti-collusion: capture location + distance from job site at join time
  joinLat            Float?
  joinLng            Float?
  joinDistanceMeters Float?

  @@unique([orderId, userId])
  @@index([orderId])
  @@index([userId])
}

// PR-7 — Per-user commission rate (effective-dated so history is preserved).
// PR-7b — Mixed rate types: PERCENT, HOURLY, DAILY, or NONE — and the type can
// differ between OPEN orders (no quotation) and QUOTED orders (quotationId set).
//   Example — Tony (TM): openRateType=HOURLY openRateValue=130, quotedRateType=DAILY quotedRateValue=400
//   Example — Themba (TM): openRateType=PERCENT openRateValue=0.35, quotedRateType=PERCENT quotedRateValue=0.35
//   Example — Sales agent on 10%: role="SALES_AGENT" openRateType=PERCENT openRateValue=0.10 …
model CommissionRule {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation("UserCommissionRules", fields: [userId], references: [id], onDelete: Cascade)

  role              String // "TM" | "SITE_LEAD" | "OPS" | "SALES_AGENT"
  rate              Float // legacy single percent (0.35 = 35%) — kept for backwards compat / display
  approvalThreshold Float     @default(5000) // expenses above auto-route to admin approval
  // Rate strategy for OPEN orders (Order.quotationId == null)
  openRateType      String    @default("PERCENT") // PERCENT | HOURLY | DAILY | NONE
  openRateValue     Float     @default(0) // PERCENT: 0.35=35%. HOURLY: e.g. 130 (R/h). DAILY: e.g. 400 (R/d).
  // Rate strategy for QUOTED orders (Order.quotationId != null)
  quotedRateType    String    @default("PERCENT")
  quotedRateValue   Float     @default(0)
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime? // null = current
  notes             String?

  createdById Int
  createdBy   User @relation("CommissionRuleCreator", fields: [createdById], references: [id])

  @@index([userId, effectiveFrom])
  @@index([effectiveTo])
}

// PR-7 — Per-order financial adjustments (recon variance, returns, credits, hold-back).
model OrderFinancialAdjustment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind    String // "RECONCILIATION" | "MATERIAL_RETURN" | "CREDIT_NOTE" | "WARRANTY_HOLDBACK" | "OTHER"
  amount  Float // signed (excl VAT). positive = adds to expenses; negative = credit
  vatRate Float   @default(0.15)
  notes   String?

  createdById Int
  createdBy   User @relation("OrderAdjustmentCreator", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([kind])
}

// PR-7 — Snapshot of a Technical Manager's monthly statement (immutable once locked).
model TmMonthlyStatement {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  user   User @relation("UserTmStatements", fields: [userId], references: [id], onDelete: Cascade)

  periodMonth   DateTime // first day of the month
  generatedAt   DateTime @default(now())
  generatedById Int
  generatedBy   User     @relation("TmStatementGenerator", fields: [generatedById], references: [id])

  lockedAt   DateTime?
  lockedById Int?
  lockedBy   User?     @relation("TmStatementLocker", fields: [lockedById], references: [id])

  totalQuoted      Float @default(0)
  totalSalesSlice  Float @default(0)
  totalExpenses    Float @default(0)
  totalAdjustments Float @default(0)
  totalBase        Float @default(0) // Σ commission-base per job (can be negative)
  rateSnapshot     Float @default(0.35)
  totalCommission  Float @default(0)
  jobCount         Int   @default(0)

  payloadJson Json // full snapshot: rows[], outstanding lists, adjustments
  xlsxUrl     String?

  @@unique([userId, periodMonth])
  @@index([periodMonth])
}

// PR-8 G — Snapshot of a Sales Agent / Site Lead / Ops Manager monthly statement.
// Companion to TmMonthlyStatement; the TM one stays separate because its
// payload shape and lock semantics are richer (attribution buckets, outstanding lists).
model CrewRoleMonthlyStatement {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  role String // "SALES_AGENT" | "SITE_LEAD" | "OPS_MANAGER"

  userId Int
  user   User @relation("UserCrewRoleStatements", fields: [userId], references: [id], onDelete: Cascade)

  periodMonth   DateTime // first day of the month
  generatedAt   DateTime @default(now())
  generatedById Int
  generatedBy   User     @relation("CrewRoleStatementGenerator", fields: [generatedById], references: [id])

  lockedAt   DateTime?
  lockedById Int?
  lockedBy   User?     @relation("CrewRoleStatementLocker", fields: [lockedById], references: [id])

  totalQuoted  Float @default(0)
  totalHours   Float @default(0)
  totalDays    Float @default(0)
  totalAmount  Float @default(0)
  jobCount     Int   @default(0)

  payloadJson Json // full snapshot: rows[], totals, rate
  xlsxUrl     String?

  @@unique([role, userId, periodMonth])
  @@index([role, periodMonth])
  @@index([userId])
}

