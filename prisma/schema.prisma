  payslip Payslip?
  artisanStatement ArtisanPaymentStatement?
}

model Payslip {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payslipNumber String   @unique

  employeeId Int
  employee   User @relation("EmployeePayslips", fields: [employeeId], references: [id], onDelete: Cascade)

  paymentRequestId Int?            @unique
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  // Pay Period
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  paymentDate    DateTime

  // Earnings Breakdown
  basicSalary   Float @default(0)
  overtime      Float @default(0)
  bonus         Float @default(0)
  allowances    Float @default(0)
  commission    Float @default(0)
  otherEarnings Float @default(0)
  grossPay      Float @default(0)

  // Deductions Breakdown
  incomeTax       Float @default(0)
  uif             Float @default(0) // Unemployment Insurance Fund
  pensionFund     Float @default(0)
  medicalAid      Float @default(0)
  otherDeductions Float @default(0)
  totalDeductions Float @default(0)

  // Net Pay
  netPay Float @default(0)

  // Additional Details
  hoursWorked Float?
  daysWorked  Float?
  hourlyRate  Float?
  dailyRate   Float?

  // Tax Information
  taxReferenceNumber String?
  uifReferenceNumber String?

  // SARS PAYE Compliance
  employerUif         Float   @default(0) // Employer UIF contribution (1%)
  sdlAmount           Float   @default(0) // Skills Development Levy (1%)
  taxBracket          String? // Tax bracket applied
  taxRebate           Float   @default(0) // Primary/secondary/tertiary rebate
  annualTaxableIncome Float? // Projected annual taxable income
  sarsSourceCode3601  Float? // SARS 3601 - Salary
  sarsSourceCode3701  Float? // SARS 3701 - Bonus
  sarsSourceCode3702  Float? // SARS 3702 - Overtime
  sarsSourceCode4101  Float? // SARS 4101 - PAYE
  sarsSourceCode4141  Float? // SARS 4141 - UIF Employee
  sarsSourceCode4142  Float? // SARS 4142 - UIF Employer

  // Notes
  notes String?

  // Status tracking
  status     String    @default("GENERATED") // GENERATED, SENT, VIEWED
  sentDate   DateTime?
  viewedDate DateTime?

  @@index([employeeId])
  @@index([paymentDate])
  @@index([status])
}

model Material {
