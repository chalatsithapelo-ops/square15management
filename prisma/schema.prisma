  tenantId Int?
  tenant   PropertyManagerCustomer? @relation("TenantPayments", fields: [tenantId], references: [id])

  // Property Manager
  propertyManagerId Int?
  propertyManager   User? @relation("PropertyManagerCustomerPayments", fields: [propertyManagerId], references: [id])

  // Building
  buildingId Int?
  building   Building? @relation("BuildingPayments", fields: [buildingId], references: [id])

  // Payment Details
  paymentNumber   String  @unique
  paymentType     String // RENT, UTILITIES, CLAIM
  amount          Float
  expectedAmount  Float? // Expected rent amount for comparison
  deviationReason String? @db.Text // Notes if amount differs from expected

  // Payment Method
  paymentMethod        String? // BANK_TRANSFER, CASH, CARD, EFT
  transactionReference String?

  // Proof of Payment
  proofOfPayment String[] @default([]) // Attachment URLs

  // Status
  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  // Review
  reviewedBy      Int? // Property Manager ID who reviewed
  reviewedDate    DateTime?
  approvalNotes   String?   @db.Text
  rejectionReason String?   @db.Text

  // Allocation
  allocatedDate DateTime?

  // Dates
  paymentDate DateTime // Date when customer made payment

  // Month/Period (for rent payments)
  paymentMonth DateTime? // First day of the month being paid for

  notes String? @db.Text

  @@index([customerId])
  @@index([tenantId])
  @@index([propertyManagerId])
  @@index([buildingId])
  @@index([status])
  @@index([paymentType])
  @@index([paymentDate])
  @@index([paymentMonth])
}

// Property Manager Order - Materials tracking
model PropertyManagerOrderMaterial {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  name        String
  description String?
  quantity    Float
  unit        String   @default("unit")
  unitPrice   Float
  totalCost   Float

  orderId Int
  order   PropertyManagerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Property Manager Order - Job Activities tracking
model PropertyManagerOrderJobActivity {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  description     String?
  hoursWorked     Float?
  rate            Float?

  orderId Int
  order   PropertyManagerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  artisanId Int
  artisan   User @relation("PMOrderJobActivities", fields: [artisanId], references: [id])

  @@index([orderId])
  @@index([artisanId])
}

// Property Manager Order - Expense Slips tracking
model PropertyManagerOrderExpenseSlip {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  // Optional — artisans may log expenses without a physical slip (travel, tolls, etc.).
  url         String?
  category    SlipCategory
  description String?
  amount      Float?

  orderId Int
  order   PropertyManagerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Add relation to User model (already exists but we add new relation)
// Just document: propertyManagerContractors and ManagerFinancialMetrics relations

// Operational Expenses - Track non-order related business expenses
model OperationalExpense {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date            DateTime // Date the expense occurred
  category        ExpenseCategory
  description     String
  amount          Float
  vendor          String? // Supplier/vendor name
  referenceNumber String? // Receipt/invoice number
  notes           String?
  documentUrl     String? // URL to receipt/invoice document

  // SARS VAT Input Tax (Section 16 VAT Act)
  vatRate         Float?  @default(15) // VAT rate on this expense
  inputVatAmount  Float?  @default(0) // Input VAT claimable
  netAmount       Float? // Amount excluding VAT
  supplyType      String? @default("STANDARD") // STANDARD, ZERO_RATED, EXEMPT
  vendorVatNumber String? // Vendor's VAT registration number

  // Capital vs Revenue expenditure (IT14)
  expenditureType String? @default("REVENUE") // CAPITAL or REVENUE

  // SARS Section 11 deduction category
  sarsDeductionSection String? // e.g., S11a_GENERAL, S11d_REPAIRS, S11e_DEPRECIATION

  // User who created the expense
  createdById Int
  createdBy   User @relation("UserOperationalExpenses", fields: [createdById], references: [id], onDelete: Cascade)

  // Approval tracking
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedBy   User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // For categorization
  isRecurring     Boolean @default(false)
  recurringPeriod String? // e.g., "MONTHLY", "QUARTERLY"

  @@index([createdById])
  @@index([category])
  @@index([date])
  @@index([isApproved])
}

// Alternative Revenue - Track non-invoice related income
model AlternativeRevenue {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date            DateTime // Date the revenue was received
  category        RevenueCategory
  description     String
  amount          Float
  source          String? // Source of revenue
  referenceNumber String? // Transaction/reference number
  notes           String?
  documentUrl     String? // URL to supporting document

  // SARS VAT Output Tax
  vatRate         Float?  @default(15) // VAT rate on this revenue
  outputVatAmount Float?  @default(0) // Output VAT on this revenue
  netAmount       Float? // Amount excluding VAT
  supplyType      String? @default("STANDARD") // STANDARD, ZERO_RATED, EXEMPT

  // SARS IT14 Income source code
  sarsSourceCode String? // e.g., 4001_SALES, 4003_SERVICES, 4007_RENTAL

  // User who created the revenue entry
  createdById Int
  createdBy   User @relation("UserAlternativeRevenues", fields: [createdById], references: [id], onDelete: Cascade)

  // Approval tracking
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedBy   User?     @relation("RevenueApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // For categorization
  isRecurring     Boolean @default(false)
  recurringPeriod String? // e.g., "MONTHLY", "QUARTERLY"

  @@index([createdById])
  @@index([category])
  @@index([date])
  @@index([isApproved])
}

// ============================================
// SUBSCRIPTION & PAYMENT MODELS
// ============================================

enum PackageType {
  CONTRACTOR
  PROPERTY_MANAGER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAYFAST
  PAYSTACK
  MANUAL
}

// Package definitions (S1-S6 for Contractors, PM1-PM2 for Property Managers)
model Package {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String      @unique // S1, S2, S3, S4, S5, S6, PM1, PM2
  displayName String // "Starter Package", "Premium Package", etc.
  description String?
  type        PackageType // CONTRACTOR or PROPERTY_MANAGER

  // Pricing
  basePrice             Float // Monthly base price for one user
  additionalUserPrice   Float // Price per additional user (contractors) or employee (PM)
  additionalTenantPrice Float? // Only for Property Managers

  // Feature access
  hasQuotations        Boolean @default(false)
  hasInvoices          Boolean @default(false)
  hasStatements        Boolean @default(false)
  hasOperations        Boolean @default(false)
  hasPayments          Boolean @default(false)
  hasCRM               Boolean @default(false)
  hasProjectManagement Boolean @default(false)
  hasAssets            Boolean @default(false)
  hasHR                Boolean @default(false)
  hasMessages          Boolean @default(false)
  hasAIAgent           Boolean @default(false)
  hasAIInsights        Boolean @default(false)

  // Trial period (in days, 0 means no trial)
  trialDays Int @default(0)

  // Status
  isActive Boolean @default(true)

  // Relations
  subscriptions             Subscription[]
  contractorPackageRequests ContractorPackageRequest[]

  @@index([type])
  @@index([isActive])
}

// Subscription model - Links users to packages
model Subscription {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User/Company
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Package
  packageId Int
  package   Package @relation(fields: [packageId], references: [id])

  // Status
  status             SubscriptionStatus
  startDate          DateTime
  endDate            DateTime? // Null means ongoing
  trialEndsAt        DateTime? // When trial period ends
  cancelledAt        DateTime?
  cancellationReason String?

  // User limits
  includedUsers   Int @default(1) // Base users included
  additionalUsers Int @default(0) // Additional users purchased
  maxUsers        Int // Total users allowed (includedUsers + additionalUsers)
  currentUsers    Int @default(1) // Current active users

  // Property Manager specific
  additionalTenants     Int? @default(0)
  additionalContractors Int? @default(0)

  // Payment tracking
  nextBillingDate  DateTime?
  lastPaymentDate  DateTime?
  isPaymentOverdue Boolean   @default(false)

  // Admin notes
  notes String?

  // Relations
  payments                             Payment[]
  createdFromContractorPackageRequests ContractorPackageRequest[]

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([nextBillingDate])
}

// Payment records
model Payment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Payment details
  amount   Float
  currency String        @default("ZAR")
  status   PaymentStatus
  method   PaymentMethod

  // Gateway details
  gatewayReference String? // Payment ID from gateway
  gatewayResponse  String? // JSON response from gateway

  // Billing period
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  // Card details (last 4 digits only for security)
  cardLast4 String?
  cardBrand String?

  // Status tracking
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  refundedAt    DateTime?
  refundReason  String?

  // Invoice
  invoiceNumber String?
  invoiceUrl    String?

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

// Self-registration pending approval
model PendingRegistration {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User details
  email       String
  firstName   String
  lastName    String
  phone       String
  companyName String?

  // Account type
  accountType PackageType // CONTRACTOR or PROPERTY_MANAGER

  // Selected package
  packageId Int

  // Additional details
  additionalUsers       Int @default(0)
  additionalTenants     Int @default(0)
  additionalContractors Int @default(0)

  // Payment
  hasPaid   Boolean @default(false)
  paymentId String?

  // Status
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  approvedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?

  // Created user ID (after approval)
  createdUserId Int?

  @@index([email])
  @@index([isApproved])
  @@index([hasPaid])
}

// ===== Task Management System =====

model StaffMember {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff details
  firstName String
  lastName  String
  email     String?
  phone     String?
  staffRole StaffRole
  title     String? // Custom title like "Head Gardener"

  // Linked to Property Manager
  propertyManagerId Int
  propertyManager   User @relation("PropertyManagerStaff", fields: [propertyManagerId], references: [id])

  // Optional: linked to a building
  buildingId Int?
  building   Building? @relation("BuildingStaff", fields: [buildingId], references: [id])

  // Status
  isActive Boolean @default(true)

  // Optional user account link (for self-service portal)
  userId Int?  @unique
  user   User? @relation("StaffUserAccount", fields: [userId], references: [id])

  // Relations
  tasksAssigned PMTask[]        @relation("StaffTaskAssignments")
  taskComments  PMTaskComment[] @relation("StaffTaskComments")
  taskUpdates   PMTaskUpdate[]  @relation("StaffTaskUpdates")

  @@unique([email, propertyManagerId])
  @@index([propertyManagerId])
  @@index([staffRole])
  @@index([buildingId])
}

model PMTask {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Task identification
  taskNumber String @unique

  // Property Manager who created the task
  propertyManagerId Int
  propertyManager   User @relation("PropertyManagerTasks", fields: [propertyManagerId], references: [id])

  // Assigned staff member
  assignedToId Int
  assignedTo   StaffMember @relation("StaffTaskAssignments", fields: [assignedToId], references: [id])

  // Task details
  title       String
  description String       @db.Text
  category    TaskCategory
  priority    TaskPriority @default(MEDIUM)

  // Location
  buildingName     String?
  buildingAddress  String?
  unitNumber       String?
  specificLocation String? // e.g., "2nd floor lobby", "parking area B"

  // Status & workflow
  status             TaskStatus @default(DRAFT)
  progressPercentage Float      @default(0)
  isPaused           Boolean    @default(false)
  pausedAt           DateTime?
  pauseReason        String?

  // Timeline
  dueDate        DateTime?
  startDate      DateTime?
  completedDate  DateTime?
  acceptedDate   DateTime?
  estimatedHours Float?
  actualHours    Float?

  // Job execution fields (similar to artisan workflow)
  startTime      DateTime?
  endTime        DateTime?
  beforePictures String[]  @default([])
  afterPictures  String[]  @default([])
  materialCost   Float     @default(0)
  labourCost     Float     @default(0)

  // Report / findings
  findings        String?   @db.Text
  recommendations String?   @db.Text
  reportUrl       String?
  signedOffBy     String?
  signedOffDate   DateTime?

  // Recurrence (for recurring tasks)
  isRecurring        Boolean   @default(false)
  recurrencePattern  String? // e.g., "DAILY", "WEEKLY", "MONTHLY"
  nextRecurrenceDate DateTime?

  // Checklist items stored as JSON
  checklist String? @db.Text // JSON array of {item, completed}

  // Attachments and notes
  attachments String[] @default([])
  notes       String?  @db.Text

  // Relations
  comments     PMTaskComment[]
  updates      PMTaskUpdate[]
  materials    PMTaskMaterial[]
  expenseSlips PMTaskExpenseSlip[]

  @@index([propertyManagerId])
  @@index([assignedToId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([dueDate])
}

model PMTaskComment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  taskId Int
  task   PMTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Who commented (PM or staff)
  authorType    String // "PM" or "STAFF"
  authorPMId    Int?
  authorPM      User?        @relation("PMTaskCommentsAuthored", fields: [authorPMId], references: [id])
  authorStaffId Int?
  authorStaff   StaffMember? @relation("StaffTaskComments", fields: [authorStaffId], references: [id])

  message   String   @db.Text
  photos    String[] @default([])
  documents String[] @default([])

  @@index([taskId])
}

model PMTaskUpdate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  taskId Int
  task   PMTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Who made the update
  updatedByType    String // "PM" or "STAFF"
  updatedByPMId    Int?
  updatedByPM      User?        @relation("PMTaskUpdatesAuthored", fields: [updatedByPMId], references: [id])
  updatedByStaffId Int?
  updatedByStaff   StaffMember? @relation("StaffTaskUpdates", fields: [updatedByStaffId], references: [id])

  status             String
  message            String @db.Text
  progressPercentage Float?

  photos    String[] @default([])
  documents String[] @default([])

  @@index([taskId])
}

model PMTaskMaterial {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  name        String
  description String?
  quantity    Float
  unit        String   @default("unit")
  unitPrice   Float
  totalCost   Float

  taskId Int
  task   PMTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model PMTaskExpenseSlip {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  url         String
  category    SlipCategory
  description String?
  amount      Float?

  taskId Int
  task   PMTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ============================================
// SARS COMPLIANCE & AUDIT MODELS
// ============================================

// Audit Trail - Section 29 Tax Administration Act
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId     Int?
  userName   String? // Denormalized for quick access
  action     String // CREATE, UPDATE, DELETE, EXPORT, GENERATE_REPORT
  entityType String // e.g., Invoice, Payslip, Asset, OperationalExpense
  entityId   Int?
  changes    String? // JSON diff of before/after values
  ipAddress  String?
  userAgent  String?

  // Context
  module      String? // e.g., accounts, payroll, invoices
  description String? // Human-readable description

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@index([action])
}

// SARS Tax Configuration
model SARSTaxConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxYear  String  @unique // e.g., "2024/2025"
  isActive Boolean @default(true)

  // Company Tax
  companyTaxRate Float @default(27) // 27% for companies

  // VAT
  standardVatRate Float @default(15)

  // SDL
  sdlRate      Float @default(1) // 1% of payroll
  sdlThreshold Float @default(500000) // Annual payroll threshold

  // UIF
  uifEmployeeRate Float @default(1)
  uifEmployerRate Float @default(1)
  uifMaxEarnings  Float @default(17712) // Monthly ceiling for UIF

  // Tax brackets (stored as JSON array)
  taxBrackets   String // JSON: [{min, max, rate, baseAmount}]
  taxRebates    String // JSON: {primary, secondary, tertiary}
  taxThresholds String // JSON: {below65, age65to74, age75plus}

  // Important dates
  provisionalTax1stDue   DateTime?
  provisionalTax2ndDue   DateTime?
  provisionalTaxTopUpDue DateTime?
  vatSubmissionFrequency String    @default("BI_MONTHLY") // MONTHLY or BI_MONTHLY

  createdById Int?
}

// ─── Bank Feed Automation ────────────────────────────────────────────────────

enum BankAccountType {
  CHEQUE
  SAVINGS
  CREDIT_CARD
  BUSINESS
  PETROL_CARD
}

enum BankName {
  FNB
  ABSA
  STANDARD_BANK
  NEDBANK
  CAPITEC
  INVESTEC
  TYMEBANK
  DISCOVERY
  OTHER
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum CategorizationSource {
  RULE
  AI
  MANUAL
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  PARTIALLY_MATCHED
  DISPUTED
  IGNORED
}

model BankAccount {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountName   String // User-friendly name e.g. "FNB Business Cheque"
  bankName      BankName
  accountNumber String // Last 4 digits only for display
  branchCode    String?
  accountType   BankAccountType @default(CHEQUE)
  currency      String          @default("ZAR")
  isActive      Boolean         @default(true)

  // Email feed config
  notificationEmail     String? // Email address notifications come from (e.g. noreply@fnb.co.za)
  notificationSubject   String? // Subject line filter pattern
  feedEnabled           Boolean   @default(false)
  lastFeedCheck         DateTime?
  lastFeedTransactionAt DateTime?

  // External aggregator linkage (Stitch / Mono) - Phase 2 direct bank feed
  externalProvider      String?
  externalAccountId     String?
  externalLinkageId     String?
  externalRefreshToken  String?
  externalAccessToken   String?
  externalTokenExpiry   DateTime?
  externalSyncCursor    String?
  externalLastSyncAt    DateTime?
  externalLastError     String?
  externalConsentExpiry DateTime?

  // Live balance snapshot (refreshed by Nedbank nightly + 15-min poller)
  currentBalance    Float?
  availableBalance  Float?
  balanceCurrency   String?
  balanceType       String? // CurrentBalance / InterimAvailable / ClosingBooked
  balanceIndicator  String? // Credit / Debit
  balanceAsOf       DateTime?
  balanceCapturedAt DateTime?

  // Owner
  createdById Int
  createdBy   User @relation("BankAccountCreator", fields: [createdById], references: [id])

  // Relations
  transactions  BankTransaction[]
  importBatches BankImportBatch[]
  statements    BankAccountStatement[]

  @@unique([bankName, accountNumber])
  @@index([createdById])
  @@index([isActive])
  @@index([externalProvider, externalAccountId])
}

model BankAccountStatement {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  externalStatementId     String
  statementReference      String?
  statementType           String?
  startDateTime           DateTime
  endDateTime             DateTime?
  creationDateTime        DateTime?

  broughtForwardAmount    Float?
  broughtForwardIndicator String?
  carriedForwardAmount    Float?
  carriedForwardIndicator String?

  currency                String  @default("ZAR")

  @@unique([bankAccountId, externalStatementId])
  @@index([bankAccountId, startDateTime])
}

model MaintenanceArtisanLink {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applicationId Int         @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  employeeUserId            Int?
  firestoreProjectId        String   @default("promaintapp-b618a")
  firestorePendingDocId     String?  // doc id in pendingArtisans/{id}
  firestoreServiceProviderId String? // doc id in serviceProvider/{id} once approved

  status                    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  pushedAt                  DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  rejectionReason           String?

  @@index([status])
}

model BankFeedWebhookLog {
  id             Int       @id @default(autoincrement())
  receivedAt     DateTime  @default(now())
  provider       String
  eventType      String
  signatureValid Boolean
  rawPayload     Json
  processedAt    DateTime?
  error          String?
  bankAccountId  Int?

  @@index([receivedAt])
  @@index([bankAccountId])
  @@index([provider, eventType])
}

model BankTransaction {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  transactionDate DateTime
  description     String // Original bank description
  amount          Float // Always positive
  transactionType TransactionType // DEBIT or CREDIT
  balance         Float? // Running balance after transaction
  reference       String? // Bank reference number
  rawDescription  String? // Unprocessed original text

  // Deduplication
  transactionHash String @unique // SHA256(date + amount + description + balance)

  // Import tracking
  importBatchId Int?
  importBatch   BankImportBatch? @relation(fields: [importBatchId], references: [id])
  source        String           @default("EMAIL") // EMAIL, CSV, API

  // Categorization
  categorization TransactionCategorization?

  // Reconciliation
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  reconciledAt         DateTime?

  // Linked entities (after reconciliation)
  linkedInvoiceId            Int?
  linkedOperationalExpenseId Int?
  linkedPaymentRequestId     Int?
  linkedAlternativeRevenueId Int?

  // PR-7 — Per-job linkage (1:1 with ExpenseSlip; many-to-one with Order)
  linkedExpenseSlip ExpenseSlip? @relation("BankTransactionExpenseSlip")
  linkedOrderId     Int?
  linkedOrder       Order?       @relation("BankTransactionOrder", fields: [linkedOrderId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([reconciliationStatus])
  @@index([importBatchId])
  @@index([linkedOrderId])
}

model BankImportBatch {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  fileName     String? // Original file name for CSV imports
  source       String // EMAIL, CSV, API
  importedById Int
  importedBy   User    @relation("BankImportBatchCreator", fields: [importedById], references: [id])

  transactionCount Int       @default(0)
  newCount         Int       @default(0) // Transactions that were new (not duplicates)
  duplicateCount   Int       @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  status           String    @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  errorMessage     String?

  transactions BankTransaction[]

  @@index([bankAccountId])
  @@index([importedById])
}

model TransactionCategorization {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankTransactionId Int             @unique
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  // Categorization
  category    String // Maps to ExpenseCategory or "REVENUE_*"
  subcategory String?
  confidence  Float                @default(0) // 0-100
  suggestedBy CategorizationSource @default(AI)

  // Linked entity (what this transaction maps to in the system)
  linkedEntityType String? // INVOICE, OPERATIONAL_EXPENSE, PAYMENT_REQUEST, ALTERNATIVE_REVENUE, SALARY
  linkedEntityId   Int?

  // Review
  isConfirmed   Boolean   @default(false)
  confirmedById Int?
  confirmedBy   User?     @relation("CategorizationConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  notes         String?

  // AI reasoning
  aiReasoning String? // Why the AI picked this category

  @@index([category])
  @@index([isConfirmed])
  @@index([suggestedBy])
}

model CategorizationRule {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matching pattern
  pattern         String // Regex or keyword to match against description
  vendor          String? // Exact vendor name match
  amountMin       Float? // Optional amount range filter
  amountMax       Float?
  transactionType TransactionType? // Only match DEBIT or CREDIT

  // Result
  category         String // Target category
  subcategory      String?
  linkedEntityType String? // What type of entity to create/link

  // Rule metadata
  priority      Int       @default(0) // Higher = checked first
  isActive      Boolean   @default(true)
  isSystemRule  Boolean   @default(false) // System-generated vs user-created
  matchCount    Int       @default(0) // How many times this rule has matched
  lastMatchedAt DateTime?

  createdById Int
  createdBy   User @relation("CategorizationRuleCreator", fields: [createdById], references: [id])

  @@index([isActive, priority])
  @@index([createdById])
}

// ── Email-to-Order Automation ────────────────────────────────────────
model OrderEmailSource {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Email metadata
  fromEmail   String
  fromName    String?
  subject     String
  bodyPreview String // First 2000 chars of email body
  receivedAt  DateTime
  emailHash   String   @unique // MD5 dedup (from+subject+date)

  // AI extraction result
  aiExtracted  Json // Full AI response JSON
  aiConfidence Float @default(0) // 0-1 confidence score

  // Processing status
  status       String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, DUPLICATE
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNotes  String?

  // Link to created order
  orderId Int?   @unique
  order   Order? @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([fromEmail])
}

model QuoteEmailSource {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Email metadata
  fromEmail   String
  fromName    String?
  subject     String
  bodyPreview String // First 2000 chars of email body
  receivedAt  DateTime
  emailHash   String   @unique // MD5 dedup (from+subject+date)

  // AI extraction result
  aiExtracted  Json // Full AI response JSON
  aiConfidence Float @default(0) // 0-1 confidence score

  // Processing status
  status       String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, DUPLICATE
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNotes  String?

  // Link to created quotation
  quotationId Int?       @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  @@index([status])
  @@index([fromEmail])
}

// ═══════════════════════════════════════════════════════════════════════
// AI Artisan Recruitment Pipeline
// ═══════════════════════════════════════════════════════════════════════

enum ApplicationStatus {
  NEW
  ASSESSMENTS_PENDING
  ASSESSMENTS_COMPLETE
  INTERVIEW_PENDING
  INTERVIEW_COMPLETE
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
  ONBOARDED
}

model ArtisanApplication {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal info
  firstName   String
  lastName    String
  email       String
  phone       String
  idNumber    String?
  dateOfBirth DateTime?
  gender      String?
  city        String?
  province    String?
  address     String?

  // Professional info
  primaryTrade      String // Plumbing, Electrical, Painting, etc.
  secondaryTrades   String[] @default([])
  yearsExperience   Int
  qualifications    String? // Certs, trade test, etc.
  portfolioUrls     String[] @default([])
  currentEmployer   String?
  availability      String? // Immediate, 2 weeks, 1 month
  expectedSalary    String?
  hasOwnTools       Boolean  @default(false)
  hasDriversLicense Boolean  @default(false)
  hasOwnTransport   Boolean  @default(false)
  motivationLetter  String?  @db.Text

  // Unique token for assessment/interview access
  accessToken String @unique @default(cuid())

  // Pipeline status
  status ApplicationStatus @default(NEW)

  // AI Composite Score (0-100)
  overallScore Float?
  aiSummary    String? @db.Text
  aiRedFlags   String? @db.Text
  aiStrengths  String? @db.Text

  // Reviewer
  reviewedById Int?
  reviewedBy   User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?   @db.Text

  // Link to created user after onboarding
  onboardedUserId Int? @unique

  // Relations
  assessments        ArtisanAssessment[]
  interviewResponses ArtisanInterviewResponse[]

  @@index([status])
  @@index([primaryTrade])
  @@index([email])
  @@index([overallScore])
}

model ArtisanAssessment {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  applicationId Int
  application   ArtisanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Assessment type: IQ, EQ, MBTI, BIG_FIVE
  type String

  // Raw responses stored as JSON
  responses Json

  // Computed results
  score      Float? // Overall score for this assessment
  results    Json? // Structured results (e.g. MBTI type, Big Five scores)
  aiAnalysis String? @db.Text // AI interpretation

  @@unique([applicationId, type])
  @@index([applicationId])
}

model ArtisanInterviewResponse {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  applicationId Int
  application   ArtisanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  questionIndex Int
  question      String @db.Text
  answer        String @db.Text

  // AI evaluation
  aiScore    Float? // 0-10
  aiAnalysis String? @db.Text
  dimensions Json? // { professionalism: 8, problemSolving: 7, ... }

  @@index([applicationId])
}

// ═══════════════════════════════════════════════════════════════════════
// RECRUITMENT 2.0 — Modern Applicant Tracking System
// Generalized Jobs, Pipelines, Applications, Scorecards, Interviews,
// Offers, Talent Pool, Compliance & Analytics
// ═══════════════════════════════════════════════════════════════════════

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
}

enum JobVisibility {
  PUBLIC
  INTERNAL
  PRIVATE
}

enum JobType {
  COMMERCIAL
  MAINTENANCE_APP
}

enum StageBucket {
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  BACKGROUND_CHECK
  HIRED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum SourceChannel {
  CAREER_SITE
  REFERRAL
  LINKEDIN
  INDEED
  FACEBOOK
  WHATSAPP
  WALK_IN
  AGENCY
  INTERNAL
  REDISCOVERY
  OTHER
}

model Job {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title            String
  slug             String         @unique @default(cuid())
  department       String?
  location         String?
  province         String?
  employmentType   EmploymentType @default(FULL_TIME)
  experienceLevel  String?
  description      String         @db.Text
  responsibilities String?        @db.Text
  requirements     String?        @db.Text
  niceToHaves      String?        @db.Text
  minSalary        Float?
  maxSalary        Float?
  salaryPeriod     String         @default("MONTHLY") // MONTHLY | DAILY | HOURLY | WEEKLY | ANNUAL
  marketRelated    Boolean        @default(false)
  currency         String         @default("ZAR")
  headcount        Int            @default(1)
  openings         Int            @default(1)
  status           JobStatus      @default(DRAFT)
  visibility       JobVisibility  @default(PUBLIC)
  targetCloseDate  DateTime?
  openedAt         DateTime?
  closedAt         DateTime?

  category String? // e.g. Plumbing, Electrical, Admin, Driver

  // Commercial (default) vs MaintenanceApp candidates take different pipelines
  jobType  JobType @default(COMMERCIAL)

  hiringManagerId Int?
  hiringManager   User? @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  recruiterId     Int?
  recruiter       User? @relation("JobRecruiter", fields: [recruiterId], references: [id])

  createdById Int
  createdBy   User @relation("JobCreator", fields: [createdById], references: [id])

  pipelineId Int?
  pipeline   JobPipeline? @relation(fields: [pipelineId], references: [id])

  requireIQ         Boolean @default(true)
  requireEQ         Boolean @default(true)
  requireBigFive    Boolean @default(true)
  requireMBTI       Boolean @default(true)
  requireSJT        Boolean @default(false)
  requireWorkSample Boolean @default(true)
  requireInterview  Boolean @default(true)

  scoringWeights Json? // { iq:0.15, eq:0.25, bigFive:0.25, interview:0.35 }
  competencies   String[] @default([])

  // Internal mobility flag
  internalOnly          Boolean  @default(false)
  eligibleInternalRoles String[] @default([])

  // Response SLA promised to candidates (working days) — shown on careers success page.
  slaResponseDays Int? @default(5)

  applications    Application[]
  approvals       JobApproval[]
  scorecards      Scorecard[]
  interviewPanels InterviewPanel[]
  customStages    JobPipelineStage[] @relation("JobCustomStages")
  workSampleTasks WorkSampleTask[]
  interviewQuestionBank InterviewQuestionBank?

  @@index([status])
  @@index([department])
  @@index([category])
  @@index([hiringManagerId])
  @@index([visibility])
  screeningQuestions ScreeningQuestion[] @relation("JobScreeningQuestions")
}

model JobApproval {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  jobId      Int
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  approverId Int
  approver   User      @relation("JobApprover", fields: [approverId], references: [id])
  order      Int
  decision   String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes      String?
  decidedAt  DateTime?

  @@index([jobId])
}

model JobPipeline {
  id          Int                @id @default(autoincrement())
  createdAt   DateTime           @default(now())
  name        String             @unique
  description String?
  isDefault   Boolean            @default(false)
  stages      JobPipelineStage[] @relation("PipelineStages")
  jobs        Job[]
}

model JobPipelineStage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name              String
  order             Int
  bucket            StageBucket @default(APPLIED)
  slaHours          Int?
  autoAdvance       Boolean     @default(false)
  requiresScorecard Boolean     @default(false)

  pipelineId Int?
  pipeline   JobPipeline? @relation("PipelineStages", fields: [pipelineId], references: [id], onDelete: Cascade)

  jobId Int?
  job   Job? @relation("JobCustomStages", fields: [jobId], references: [id], onDelete: Cascade)

  applicationsAtStage Application[]             @relation("ApplicationCurrentStage")
  stageHistories      ApplicationStageHistory[]

  @@index([pipelineId])
  @@index([jobId])
}

model Application {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Candidate snapshot
  firstName        String
  lastName         String
  email            String
  phone            String?
  idNumber         String?
  dateOfBirth      DateTime?
  gender           String?
  city             String?
  province         String?
  address          String?
  primaryTrade     String?
  yearsExperience  Int?
  qualifications   String?   @db.Text
  portfolioUrls    String[]  @default([])
  resumeUrl        String?
  motivationLetter String?   @db.Text
  expectedSalary   String?
  availability     String?
  linkedInUrl      String?

  // Link to job
  jobId Int?
  job   Job? @relation(fields: [jobId], references: [id])

  // Link to legacy artisan app
  legacyArtisanAppId Int? @unique

  // Token
  accessToken          String    @unique @default(cuid())
  accessTokenExpiresAt DateTime?

  // Pipeline
  currentStageId Int?
  currentStage   JobPipelineStage? @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id])
  stageBucket    StageBucket       @default(APPLIED)
  stageEnteredAt DateTime          @default(now())

  // AI + scoring
  overallScore       Float?
  humanScore         Float?
  aiSummary          String? @db.Text
  aiStrengths        String? @db.Text
  aiRedFlags         String? @db.Text
  aiMatchScore       Float? // 0-100 match vs job requirements
  aiMatchExplanation String? @db.Text

  // Source attribution
  sourceChannel  SourceChannel @default(CAREER_SITE)
  sourceDetail   String?
  referrerUserId Int?
  referrer       User?         @relation("ApplicationReferrer", fields: [referrerUserId], references: [id])
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  landingUrl     String?

  // Consent (POPIA)
  consentGivenAt       DateTime?
  consentVersion       String?
  consentIp            String?
  consentUserAgent     String?
  privacyPolicyVersion String?
  dataRetentionOptIn   Boolean   @default(false)

  // Retention
  retainUntil DateTime?
  deletedAt   DateTime?

  // Team
  assignedRecruiterId Int?
  assignedRecruiter   User?     @relation("ApplicationRecruiter", fields: [assignedRecruiterId], references: [id])
  reviewedById        Int?
  reviewedBy          User?     @relation("ApplicationReviewer2", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?   @db.Text

  // Decision
  rejectionReasonId Int?
  rejectionReason   RejectionReason? @relation(fields: [rejectionReasonId], references: [id])
  rejectionDetail   String?
  withdrawnAt       DateTime?
  withdrawnReason   String?
  hiredAt           DateTime?
  onboardedUserId   Int?             @unique

  // Phase-1 anti-fabrication caches (recomputed by recomputeApplicationScore).
  redFlagScore    Int? // 0-100, higher = more concerning
  redFlagSignals  Json? // Array of { code, label, weight, evidence }
  workSampleScore Float? // Cached aggregate of WorkSampleSubmission scores

  // Fast-track hire (Maintenance App). Auto-flagged when candidate passes threshold.
  fastTrackReady        Boolean   @default(false)
  fastTrackApprovedById Int?
  fastTrackApprovedBy   User?     @relation("ApplicationFastTrackApprover", fields: [fastTrackApprovedById], references: [id])
  fastTrackApprovedAt   DateTime?
  maintenanceArtisanLink MaintenanceArtisanLink?

  // Relations
  assessments           ApplicationAssessment[]
  interviewResponses    ApplicationInterviewResponse[]
  scorecardSubmissions  ScorecardSubmission[]
  interviewBookings     InterviewBooking[]
  stageHistory          ApplicationStageHistory[]
  offers                Offer[]
  backgroundChecks      BackgroundCheck[]
  referenceChecks       ReferenceCheck[]
  notes                 ApplicationNote[]
  attachments           ApplicationAttachment[]
  demographicProfile    DemographicProfile?
  consentEvents         ConsentEvent[]
  messages              ApplicationMessage[]
  talentPoolMemberships TalentPoolMembership[]
  workSampleSubmissions WorkSampleSubmission[]
  interviewQuestionScores InterviewQuestionScore[]
  performanceCheckIns   PerformanceCheckIn[]
  employmentVerifications EmploymentVerification[]
  assessmentSessions    AssessmentSession[]
  hiringOverrides       HiringOverride[]
  blindRevealAudits     BlindRevealAudit[]

  @@index([jobId])
  @@index([stageBucket])
  @@index([email])
  @@index([currentStageId])
  @@index([assignedRecruiterId])
  @@index([reviewedById])
  @@index([overallScore])
  @@index([sourceChannel])
  @@index([retainUntil])
  @@index([deletedAt])
  screeningAnswers   ScreeningAnswer[] @relation("ApplicationScreeningAnswers")
}

model ApplicationAssessment {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  completedAt   DateTime?
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // IQ, EQ, BIG_FIVE, SJT, WORK_SAMPLE
  responses     Json
  score         Float?
  results       Json?
  aiAnalysis    String?     @db.Text

  @@unique([applicationId, type])
  @@index([applicationId])
}

model ApplicationInterviewResponse {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionIndex Int
  question      String      @db.Text
  answer        String      @db.Text
  aiScore       Float?
  aiAnalysis    String?     @db.Text
  dimensions    Json?

  // Cheating-defense signals (Tier 1)
  integritySignals Json?
  aiWritingScore   Float?
  aiWritingSignals Json?

  @@index([applicationId])
}

model ApplicationStageHistory {
  id            Int               @id @default(autoincrement())
  createdAt     DateTime          @default(now())
  applicationId Int
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStageId   Int?
  toStageId     Int?
  toStage       JobPipelineStage? @relation(fields: [toStageId], references: [id])
  bucket        StageBucket
  movedById     Int?
  movedBy       User?             @relation("StageMover", fields: [movedById], references: [id])
  reason        String?
  durationHours Float?

  @@index([applicationId])
  @@index([toStageId])
}

model Scorecard {
  id          Int                   @id @default(autoincrement())
  createdAt   DateTime              @default(now())
  name        String
  description String?
  isTemplate  Boolean               @default(false)
  stage       String? // Phase-2: gates by pipeline bucket (SCREENING/ASSESSMENT/INTERVIEW/OFFER)
  jobId       Int?
  job         Job?                  @relation(fields: [jobId], references: [id])
  criteria    ScorecardCriterion[]
  submissions ScorecardSubmission[]

  @@index([jobId])
  @@index([stage])
}

model ScorecardCriterion {
  id          Int       @id @default(autoincrement())
  scorecardId Int
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weight      Float     @default(1.0)
  order       Int       @default(0)

  @@index([scorecardId])
}

model ScorecardSubmission {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  submittedAt    DateTime?
  scorecardId    Int
  scorecard      Scorecard   @relation(fields: [scorecardId], references: [id])
  applicationId  Int
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId  Int
  interviewer    User        @relation("ScorecardInterviewer", fields: [interviewerId], references: [id])
  stage          String?
  overallRating  Float?
  recommendation String? // STRONG_HIRE, HIRE, NO_HIRE, STRONG_NO_HIRE
  strengths      String?     @db.Text
  concerns       String?     @db.Text
  notes          String?     @db.Text
  ratings        Json?
  blindMode      Boolean     @default(false)

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scorecardId])
}

model InterviewPanel {
  id        Int                    @id @default(autoincrement())
  createdAt DateTime               @default(now())
  jobId     Int?
  job       Job?                   @relation(fields: [jobId], references: [id])
  name      String
  members   InterviewPanelMember[]
  bookings  InterviewBooking[]
}

model InterviewPanelMember {
  id       Int            @id @default(autoincrement())
  panelId  Int
  panel    InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  userId   Int
  user     User           @relation("PanelMember", fields: [userId], references: [id])
  role     String?
  required Boolean        @default(true)

  @@unique([panelId, userId])
}

model InterviewSlot {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  interviewerId  Int
  interviewer    User              @relation("InterviewerSlots", fields: [interviewerId], references: [id])
  startTime      DateTime
  endTime        DateTime
  timezone       String            @default("Africa/Johannesburg")
  isRecurring    Boolean           @default(false)
  recurrenceRule String?
  available      Boolean           @default(true)
  booking        InterviewBooking?

  @@index([interviewerId])
  @@index([startTime])
}

model InterviewBooking {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  panelId Int?
  panel   InterviewPanel? @relation(fields: [panelId], references: [id])

  slotId Int?           @unique
  slot   InterviewSlot? @relation(fields: [slotId], references: [id])

  scheduledStart DateTime
  scheduledEnd   DateTime
  timezone       String   @default("Africa/Johannesburg")

  location            String?
  meetingUrl          String?
  stage               String?
  status              String    @default("SCHEDULED")
  agenda              String?   @db.Text
  candidateNotifiedAt DateTime?
  reminderSentAt      DateTime?
  completedAt         DateTime?
  cancellationReason  String?

  createdById Int
  createdBy   User @relation("BookingCreator", fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([scheduledStart])
}

model RejectionReason {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  label        String
  category     String
  description  String?
  active       Boolean       @default(true)
  applications Application[]
}

model Offer {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  title        String
  startDate    DateTime
  baseSalary   Float
  currency     String   @default("ZAR")
  salaryPeriod String   @default("MONTHLY")
  bonus        Float?
  benefits     String?  @db.Text
  otherTerms   String?  @db.Text

  hourlyRate    Float?
  dailyRate     Float?
  monthlySalary Float?

  status        OfferStatus @default(DRAFT)
  version       Int         @default(1)
  expiresAt     DateTime?
  sentAt        DateTime?
  viewedAt      DateTime?
  respondedAt   DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  withdrawnAt   DateTime?
  declineReason String?

  // Internal e-signature
  signToken              String?   @unique @default(cuid())
  candidateSignature     String?
  candidateSignedAt      DateTime?
  candidateSignIp        String?
  candidateSignUserAgent String?
  candidateInitials      String?

  pdfUrl String?

  createdById Int
  createdBy   User @relation("OfferCreator", fields: [createdById], references: [id])

  approvals OfferApproval[]

  @@index([applicationId])
  @@index([status])
}

model OfferApproval {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  offerId    Int
  offer      Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  approverId Int
  approver   User      @relation("OfferApprover", fields: [approverId], references: [id])
  order      Int
  decision   String    @default("PENDING")
  notes      String?
  decidedAt  DateTime?

  @@index([offerId])
}

model BackgroundCheck {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      String      @default("INTERNAL")
  externalRef   String?
  checkTypes    String[]    @default([])
  status        String      @default("PENDING")
  result        String?
  reportUrl     String?
  summary       String?     @db.Text
  requestedById Int
  requestedBy   User        @relation("BackgroundRequester", fields: [requestedById], references: [id])
  completedAt   DateTime?

  candidateUploadToken String? @unique
  candidateNotifiedAt  DateTime?
  assignedAssessorId   Int?
  assignedAssessor     User?     @relation("BgCheckAssignedAssessor", fields: [assignedAssessorId], references: [id], onDelete: SetNull)
  assessorNotifiedAt   DateTime?
  documents            BackgroundCheckDocument[]

  @@index([applicationId])
}

model BackgroundCheckDocument {
