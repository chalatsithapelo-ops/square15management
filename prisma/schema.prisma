  convertedToRFQId   Int?
  convertedToOrderId Int?
  conversionType     String? // RFQ or ORDER
  convertedDate      DateTime?

  @@index([customerId])
  @@index([propertyManagerId])
  @@index([status])
  @@index([recipientType])
