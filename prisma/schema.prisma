  toSiteLeadId   Int?
  toSiteLead     User? @relation("SiteLeadLogTo", fields: [toSiteLeadId], references: [id], onDelete: SetNull)

  // Attribution source. Kept as String (not enum) so we can add sources without a migration.
  //   EXPLICIT_INPUT               – admin/agent typed a site-lead id at create time
