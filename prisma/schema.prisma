model User {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  email             String   @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              String
  hourlyRate        Float?
  dailyRate         Float?
  monthlySalary     Float?
  monthlyPaymentDay Int? // Day of month (1-31) when monthly salary is paid

  // Personal email configuration for sending emails through user's own account
  userEmailSmtpHost         String?
  userEmailSmtpPort         Int?
  userEmailSmtpSecure       Boolean?
  userEmailSmtpUser         String?
  userEmailSmtpPassword     String?
  userEmailConfiguredAt     DateTime?
  userEmailLastTestedAt     DateTime?
  disabledNotificationTypes String[]  @default([])

  // Property Manager company details (for PDFs and documents)
  pmCompanyName              String?
  pmCompanyAddressLine1      String?
  pmCompanyAddressLine2      String?
  pmCompanyPhone             String?
  pmCompanyEmail             String?
  pmCompanyVatNumber         String?
  pmCompanyBankName          String?
  pmCompanyBankAccountName   String?
  pmCompanyBankAccountNumber String?
  pmCompanyBankBranchCode    String?

  // Property Manager branding (for PDFs)
  pmBrandPrimaryColor   String? @default("#2D5016")
  pmBrandSecondaryColor String? @default("#F4C430")
  pmBrandAccentColor    String? @default("#5A9A47")

  // Contractor branding (for PDFs)
  contractorBrandPrimaryColor   String? @default("#2D5016")
  contractorBrandSecondaryColor String? @default("#F4C430")
  contractorBrandAccentColor    String? @default("#5A9A47")

  // Contractor company details (for PDFs and documents)
  contractorCompanyName              String?
  contractorCompanyAddressLine1      String?
  contractorCompanyAddressLine2      String?
  contractorCompanyPhone             String?
  contractorCompanyEmail             String?
  contractorCompanyVatNumber         String?
  contractorCompanyBankName          String?
  contractorCompanyBankAccountName   String?
  contractorCompanyBankAccountNumber String?
  contractorCompanyBankBranchCode    String?

  // Employee management (contractor-owned employees)
  employerId Int?
  employer   User?  @relation("EmployerEmployees", fields: [employerId], references: [id], onDelete: SetNull)
  employees  User[] @relation("EmployerEmployees")

  // Default Technical Manager responsible for this user's jobs (drives commission on self-initiated work)
  defaultTechnicalManagerId Int?
  defaultTechnicalManager   User?  @relation("UserDefaultTM", fields: [defaultTechnicalManagerId], references: [id], onDelete: SetNull)
  reportsAsDefaultTMFor     User[] @relation("UserDefaultTM")

  // PR-8 F — Default Site Lead + Ops Manager responsible for this user's jobs
  // (same resolution pattern as TM: user default → building default → client default → null).
  defaultSiteLeadId           Int?
  defaultSiteLead             User?  @relation("UserDefaultSiteLead", fields: [defaultSiteLeadId], references: [id], onDelete: SetNull)
  reportsAsDefaultSiteLeadFor User[] @relation("UserDefaultSiteLead")

  defaultOpsManagerId           Int?
  defaultOpsManager             User?  @relation("UserDefaultOpsManager", fields: [defaultOpsManagerId], references: [id], onDelete: SetNull)
  reportsAsDefaultOpsManagerFor User[] @relation("UserDefaultOpsManager")

  // PR-9 — Portfolio ownership preferences.
  // "MINE" filters lists to clients they own; "ALL" shows everything.
  // Junior admins default to MINE; senior admins / managers default to ALL.
  defaultPortfolioView    String  @default("ALL") // "MINE" | "ALL"
  // When on leave, the system reroutes portfolio digests + new-client
  // auto-assignments to portfolioBackupOwner during [onLeaveFrom, onLeaveUntil].
  onLeaveFrom             DateTime?
  onLeaveUntil            DateTime?
  portfolioBackupOwnerId  Int?
  portfolioBackupOwner    User?   @relation("UserPortfolioBackup", fields: [portfolioBackupOwnerId], references: [id], onDelete: SetNull)
  backupPortfolioFor      User[]  @relation("UserPortfolioBackup")

  // Reverse relations for portfolio ownership on Client + ClientBuilding.
  ownedClients          Client[]         @relation("ClientPortfolioOwner")
  ownedClientBuildings  ClientBuilding[] @relation("ClientBuildingPortfolioOwner")
  portfolioReassignsMade PortfolioOwnershipLog[] @relation("PortfolioReassignActor")

  // Relations
  leadsCreated               Lead[]                            @relation("LeadCreator")
  leadsAssignedForFollowUp   Lead[]                            @relation("LeadFollowUpAssignee")
  ordersAssigned             Order[]                           @relation("AssignedArtisan")
  quotationsAssigned         Quotation[]                       @relation("AssignedArtisan")
  quotationsCreated          Quotation[]                       @relation("QuotationCreatedBy")
  projectsAssigned           Project[]                         @relation("AssignedArtisan")
  milestonesAssigned         Milestone[]                       @relation("MilestoneAssignedTo")
  paymentRequests            PaymentRequest[]
  payslips                   Payslip[]                         @relation("EmployeePayslips")
  jobActivities              JobActivity[]
  pmOrderJobActivities       PropertyManagerOrderJobActivity[] @relation("PMOrderJobActivities")
  invoicesCreated            Invoice[]                         @relation("InvoiceCreator")
  invoiceRemittancesUploaded Invoice[]                         @relation("InvoiceRemittanceUploader")
  creditNotesCreated         CreditNote[]                      @relation("CreditNoteCreator")

  // Messaging relations
  conversations Conversation[]
  messagesSent  Message[]      @relation("MessageSender")

  // Review relations
  reviewsGiven    Review[] @relation("CustomerReviews")
  reviewsReceived Review[] @relation("ArtisanReviews")

  // Notification relations
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // HR relations
  hrDocuments        HRDocument[]        @relation("EmployeeDocuments")
  uploadedDocuments  HRDocument[]        @relation("DocumentUploader")
  kpis               EmployeeKPI[]       @relation("EmployeeKPIs")
  reviewedKPIs       EmployeeKPI[]       @relation("KPIReviewer")
  leaveRequests      LeaveRequest[]      @relation("EmployeeLeaveRequests")
  approvedLeaves     LeaveRequest[]      @relation("LeaveApprover")
  performanceReviews PerformanceReview[] @relation("EmployeePerformanceReviews")
  reviewsConducted   PerformanceReview[] @relation("ReviewerPerformanceReviews")
  campaignsCreated   Campaign[]          @relation("CampaignCreator")

  // Property Manager relations
  propertyManagerRFQs               PropertyManagerRFQ[]              @relation("PropertyManagerRFQs")
  propertyManagerOrders             PropertyManagerOrder[]            @relation("PropertyManagerOrders")
  contractorOrders                  PropertyManagerOrder[]            @relation("ContractorPropertyManagerOrders")
  assignedPropertyManagerOrders     PropertyManagerOrder[]            @relation("PropertyManagerOrderAssignedTo")
  propertyManagerInvoices           PropertyManagerInvoice[]          @relation("PropertyManagerInvoices")
  propertyManagerQuotationPdfCopies PropertyManagerQuotationPdfCopy[] @relation("PMQuotationPdfCopies")
  propertyManagerCustomers          PropertyManagerCustomer[]         @relation("PropertyManagerCustomers")
  propertyManagerBuildings          Building[]                        @relation("PropertyManagerBuildings")
  customerProfile                   PropertyManagerCustomer?          @relation("CustomerUser")
  rentPayments                      RentPayment[]                     @relation("PropertyManagerRentPayments")
  utilityReadings                   UtilityReading[]                  @relation("PropertyManagerUtilityReadings")

  // Customer Payment relations
  customerPaymentsMade    CustomerPayment[] @relation("CustomerPayments")
  customerPaymentsManaged CustomerPayment[] @relation("PropertyManagerCustomerPayments")

  // Contractor Management relations
  managedContractors Contractor[]                      @relation("PropertyManagerContractors")
  financialMetrics   PropertyManagerFinancialMetrics[] @relation("ManagerFinancialMetrics")

  // Property Manager contractor package approvals
  contractorPackageRequests            ContractorPackageRequest[] @relation("PropertyManagerContractorPackageRequests")
  approvedContractorPackageRequests    ContractorPackageRequest[] @relation("ContractorPackageRequestApprovedBy")
  rejectedContractorPackageRequests    ContractorPackageRequest[] @relation("ContractorPackageRequestRejectedBy")
  createdFromContractorPackageRequests ContractorPackageRequest[] @relation("ContractorPackageRequestCreatedUser")

  // Financial operations relations
  operationalExpenses OperationalExpense[] @relation("UserOperationalExpenses")
  approvedExpenses    OperationalExpense[] @relation("ExpenseApprover")
  alternativeRevenues AlternativeRevenue[] @relation("UserAlternativeRevenues")
  approvedRevenues    AlternativeRevenue[] @relation("RevenueApprover")

  // Subscription relations
  subscriptions Subscription[]

  // Tenant feedback (Complaints & Complements)
  tenantFeedbackReceived TenantFeedback[] @relation("PropertyManagerTenantFeedback")

  // Assets & liabilities (data isolation)
  assetsCreated      Asset[]     @relation("AssetCreator")
  liabilitiesCreated Liability[] @relation("LiabilityCreator")

  // Task Management relations
  staffMembers           StaffMember[]   @relation("PropertyManagerStaff")
  pmTasks                PMTask[]        @relation("PropertyManagerTasks")
  pmTaskCommentsAuthored PMTaskComment[] @relation("PMTaskCommentsAuthored")
  pmTaskUpdatesAuthored  PMTaskUpdate[]  @relation("PMTaskUpdatesAuthored")

  // Staff self-service portal link
  staffProfile StaffMember? @relation("StaffUserAccount")

  // CRM Clients
  clientsCreated Client[] @relation("ClientCreator")

  // Line item templates
  lineItemTemplates         LineItemTemplate[] @relation("LineItemTemplateCreator")
  lineItemTemplatesApproved LineItemTemplate[] @relation("LineItemTemplateLastApprover")

  // AI Quote Studio (materials / suppliers / tasks)
  materialsCreated         MaterialCatalog[]       @relation("MaterialCatalogCreator")
  workTaskTemplatesCreated WorkTaskTemplate[]      @relation("WorkTaskTemplateCreator")
  materialPricesVerified   MaterialSupplierPrice[] @relation("MaterialPriceVerifier")

  // Bank Feed Automation
  bankAccounts             BankAccount[]               @relation("BankAccountCreator")
  bankImportBatches        BankImportBatch[]           @relation("BankImportBatchCreator")
  categorizationsConfirmed TransactionCategorization[] @relation("CategorizationConfirmer")
  categorizationRules      CategorizationRule[]        @relation("CategorizationRuleCreator")

  // Recruitment (legacy)
  reviewedApplications ArtisanApplication[] @relation("ApplicationReviewer")

  // Recruitment 2.0 — ATS
  jobsCreated               Job[]                     @relation("JobCreator")
  jobsAsHiringManager       Job[]                     @relation("JobHiringManager")
  jobsAsRecruiter           Job[]                     @relation("JobRecruiter")
  jobApprovals              JobApproval[]             @relation("JobApprover")
  applicationsReferred      Application[]             @relation("ApplicationReferrer")
  applicationsAssignedRec   Application[]             @relation("ApplicationRecruiter")
  applicationsReviewedATS   Application[]             @relation("ApplicationReviewer2")
  stageMovesByUser          ApplicationStageHistory[] @relation("StageMover")
  scorecardSubmissionsMade  ScorecardSubmission[]     @relation("ScorecardInterviewer")
  interviewPanelMemberships InterviewPanelMember[]    @relation("PanelMember")
  interviewSlots            InterviewSlot[]           @relation("InterviewerSlots")
  interviewBookingsCreated  InterviewBooking[]        @relation("BookingCreator")
  offersCreated             Offer[]                   @relation("OfferCreator")
  offerApprovals            OfferApproval[]           @relation("OfferApprover")
  backgroundChecksRequested BackgroundCheck[]         @relation("BackgroundRequester")
  applicationNotesAuthored  ApplicationNote[]         @relation("NoteAuthor")
  applicationAttachmentsUp  ApplicationAttachment[]   @relation("AttachmentUploader")
  applicationMessagesSent   ApplicationMessage[]      @relation("MessageSender")
  talentPoolsCreated        TalentPool[]              @relation("TalentPoolCreator")
  talentPoolAdditions       TalentPoolMembership[]    @relation("PoolAdder")
  workSampleTasksCreated    WorkSampleTask[]          @relation("WorkSampleTaskCreator")
  workSampleSubmissionsScored WorkSampleSubmission[]  @relation("WorkSampleScorer")
  interviewQuestionScores   InterviewQuestionScore[]  @relation("QuestionScorer")
  performanceCheckInsAsHired PerformanceCheckIn[]     @relation("PerformanceCheckInHired")
  performanceCheckInsAsManager PerformanceCheckIn[]   @relation("PerformanceCheckInManager")
  hiringOverridesAuthored   HiringOverride[]          @relation("HiringOverrideAuthor")
  blindRevealsPerformed     BlindRevealAudit[]        @relation("BlindRevealer")

  // OHS module back-relations
  ohsDocumentsCreated             OhsDocument[]         @relation("OhsDocumentCreator")
  ohsDocumentsForContractor       OhsDocument[]         @relation("OhsDocumentContractor")
  ohsRiskAssessmentsCreated       OhsRiskAssessment[]   @relation("OhsRiskCreator")
  ohsRiskAssessmentsApproved      OhsRiskAssessment[]   @relation("OhsRiskApprover")
  ohsRiskAssessmentsForContractor OhsRiskAssessment[]   @relation("OhsRiskContractor")
  ohsIncidentsReported            OhsIncident[]         @relation("OhsIncidentReporter")
  ohsIncidentsAsInjured           OhsIncident[]         @relation("OhsIncidentInjured")
  ohsIncidentsForContractor       OhsIncident[]         @relation("OhsIncidentContractor")
  ohsCorrectiveResponsible        OhsCorrectiveAction[] @relation("OhsCorrectiveResponsible")
  ohsCorrectiveVerified           OhsCorrectiveAction[] @relation("OhsCorrectiveVerifier")
  ohsToolboxCreated               OhsToolboxTalk[]      @relation("OhsToolboxCreator")
  ohsToolboxForContractor         OhsToolboxTalk[]      @relation("OhsToolboxContractor")
  ohsAcknowledgements             OhsAcknowledgement[]  @relation("OhsAck")
  ohsTraining                     OhsTrainingRecord[]   @relation("OhsTraining")
  ohsInspectionsPerformed         OhsInspection[]       @relation("OhsInspector")
  ohsInspectionsForContractor     OhsInspection[]       @relation("OhsInspectionContractor")
  ohsPpeReceived                  OhsPpeIssue[]         @relation("OhsPpeRecipient")
  ohsPpeIssued                    OhsPpeIssue[]         @relation("OhsPpeIssuer")

  // PR-3 / PR-2 — Order initiator + admin reviewer
  ordersInitiated       Order[] @relation("OrderInitiator")
  ordersReviewedAsAdmin Order[] @relation("OrderAdminReviewer")

  // PR-6 — Multi-artisan crew memberships
  orderCrewMemberships OrderCrew[] @relation("OrderCrewMember")

  // PR-7 — Financial reconciliation + TM commission
  ordersAsSalesAgent       Order[] @relation("OrderSalesAgent")
  ordersAsTechnicalManager Order[] @relation("OrderTechnicalManager")
  ordersMonthLocked        Order[] @relation("OrderMonthLocker")

  // PR-8 — Back-relations for the TM-assignment audit trail
  tmAssignmentLogsFrom    OrderTmAssignmentLog[] @relation("TmLogFrom")
  tmAssignmentLogsTo      OrderTmAssignmentLog[] @relation("TmLogTo")
  tmAssignmentLogsAsActor OrderTmAssignmentLog[] @relation("TmLogActor")

  // PR-8 E — Sales-agent defaults + assignment audit trail
  defaultSalesAgentForClients     Client[]                       @relation("ClientDefaultSalesAgent")
  defaultSalesAgentForBuildings   ClientBuilding[]               @relation("ClientBuildingDefaultSalesAgent")
  salesAgentAssignmentLogsFrom    OrderSalesAgentAssignmentLog[] @relation("SalesAgentLogFrom")
  salesAgentAssignmentLogsTo      OrderSalesAgentAssignmentLog[] @relation("SalesAgentLogTo")
  salesAgentAssignmentLogsAsActor OrderSalesAgentAssignmentLog[] @relation("SalesAgentLogActor")

  // PR-8 F — Site Lead + Ops Manager order attribution, defaults + audit trail
  ordersAsSiteLead                 Order[]                        @relation("OrderSiteLead")
  ordersAsOpsManager               Order[]                        @relation("OrderOpsManager")
  defaultSiteLeadForClients        Client[]                       @relation("ClientDefaultSiteLead")
  defaultSiteLeadForBuildings      ClientBuilding[]               @relation("ClientBuildingDefaultSiteLead")
  defaultOpsManagerForClients      Client[]                       @relation("ClientDefaultOpsManager")
  defaultOpsManagerForBuildings    ClientBuilding[]               @relation("ClientBuildingDefaultOpsManager")
  siteLeadAssignmentLogsFrom       OrderSiteLeadAssignmentLog[]   @relation("SiteLeadLogFrom")
  siteLeadAssignmentLogsTo         OrderSiteLeadAssignmentLog[]   @relation("SiteLeadLogTo")
  siteLeadAssignmentLogsAsActor    OrderSiteLeadAssignmentLog[]   @relation("SiteLeadLogActor")
  opsManagerAssignmentLogsFrom     OrderOpsManagerAssignmentLog[] @relation("OpsManagerLogFrom")
  opsManagerAssignmentLogsTo       OrderOpsManagerAssignmentLog[] @relation("OpsManagerLogTo")
  opsManagerAssignmentLogsAsActor  OrderOpsManagerAssignmentLog[] @relation("OpsManagerLogActor")
  expenseSlipsSubmitted            ExpenseSlip[]                  @relation("ExpenseSlipSubmitter")
  expenseSlipsApproved             ExpenseSlip[]                  @relation("ExpenseSlipApprover")
  commissionRules                  CommissionRule[]               @relation("UserCommissionRules")
  commissionRulesCreated           CommissionRule[]               @relation("CommissionRuleCreator")
  orderFinancialAdjustmentsCreated OrderFinancialAdjustment[]     @relation("OrderAdjustmentCreator")
  tmStatementsAsTechManager        TmMonthlyStatement[]           @relation("UserTmStatements")
  tmStatementsGenerated            TmMonthlyStatement[]           @relation("TmStatementGenerator")
  tmStatementsLocked               TmMonthlyStatement[]           @relation("TmStatementLocker")

  // PR-8 G — SA / SL / OM monthly statements
  crewRoleStatementsAsUser         CrewRoleMonthlyStatement[]     @relation("UserCrewRoleStatements")
  crewRoleStatementsGenerated      CrewRoleMonthlyStatement[]     @relation("CrewRoleStatementGenerator")
  crewRoleStatementsLocked         CrewRoleMonthlyStatement[]     @relation("CrewRoleStatementLocker")

  // PR-4 — PM compliance management
  complianceRequirements       PmComplianceRequirement[] @relation("PmComplianceRequirementOwner")
  contractorAutoBlockOverrides Contractor[]              @relation("ContractorAutoBlockOverride")

  // PR-5 — Tenant inspections
  inspectionsConducted     TenantInspection[]   @relation("InspectionConductor")
  inspectionsOwnedByPm     TenantInspection[]   @relation("InspectionPropertyManager")
  inspectionTemplatesOwned InspectionTemplate[] @relation("InspectionTemplateOwner")

  @@index([employerId])
  fastTrackApprovedApplications Application[] @relation("ApplicationFastTrackApprover")
  wageRecipientsCreated WageReportRecipient[] @relation("WageRecipCreatedBy")
  deletedAt          DateTime?
  terminationReason  String?  // RESIGNED | DISMISSED | RETIRED | OTHER
  terminatedAt       DateTime?
  terminatedById     Int?

  bgCheckDocDecisions        BackgroundCheckDocument[] @relation("BgCheckDocDecider")
  bgCheckAssignments   BackgroundCheck[] @relation("BgCheckAssignedAssessor")
  clientWorkOrdersAssigned ClientWorkOrder[] @relation("ClientWorkOrderAssignee")
}

model Client {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  companyName String?
  email       String
  phone       String
  address     String?
  vatNumber   String?
  notes       String?

  createdById Int
  createdBy   User @relation("ClientCreator", fields: [createdById], references: [id])

  // PR-8 E — default Sales Agent for this client (resolution priority:
  // Order.salesAgentId → ClientBuilding.defaultSalesAgentId → Client.defaultSalesAgentId → null).
  defaultSalesAgentId Int?
  defaultSalesAgent   User? @relation("ClientDefaultSalesAgent", fields: [defaultSalesAgentId], references: [id], onDelete: SetNull)

  // PR-8 F — Client-level defaults for Site Lead + Ops Manager (same resolution
  // pattern as sales agent: Order.<x>Id → ClientBuilding.default<x>Id → Client.default<x>Id → null).
  defaultSiteLeadId   Int?
  defaultSiteLead     User? @relation("ClientDefaultSiteLead", fields: [defaultSiteLeadId], references: [id], onDelete: SetNull)
  defaultOpsManagerId Int?
  defaultOpsManager   User? @relation("ClientDefaultOpsManager", fields: [defaultOpsManagerId], references: [id], onDelete: SetNull)

  // PR-9 — Portfolio ownership (which admin is responsible for this client).
  // Resolution priority for any downstream doc (Invoice/Order/Quotation):
  //   ClientBuilding.portfolioOwnerId → Client.portfolioOwnerId → null (Unassigned).
  // See src/server/services/portfolioOwnership.ts for the resolver + scope helpers.
  portfolioOwnerId Int?
  portfolioOwner   User? @relation("ClientPortfolioOwner", fields: [portfolioOwnerId], references: [id], onDelete: SetNull)
  portfolioTag     String? // free-form grouping label ("Sandton commercial", etc.)

  // Reusable client → multiple sites/buildings
  buildings  ClientBuilding[]
  quotations Quotation[]      @relation("ClientQuotations")
  orders     Order[]          @relation("ClientOrders")
  invoices   Invoice[]        @relation("ClientInvoices")

  pricingMemories ClientPricingMemory[] @relation("ClientPricingMemories")

  @@index([createdById])
  @@index([email])
  clientWorkOrders  ClientWorkOrder[] @relation("ClientWorkOrderClient")
  siteMappings        ClientWorkOrderSiteMapping[] @relation("SiteMappingClient")
}

model ClientBuilding {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  address   String
  notes     String?
  isPrimary Boolean @default(false)

  // Building-specific contact (e.g. property manager assigned to this building).
  managerName  String?
  managerEmail String?
  managerPhone String?

  // PR-8 E — building-scoped default sales agent (wins over Client-level default).
  defaultSalesAgentId Int?
  defaultSalesAgent   User? @relation("ClientBuildingDefaultSalesAgent", fields: [defaultSalesAgentId], references: [id], onDelete: SetNull)

  // PR-8 F — building-scoped defaults for Site Lead + Ops Manager (win over Client-level defaults).
  defaultSiteLeadId   Int?
  defaultSiteLead     User? @relation("ClientBuildingDefaultSiteLead", fields: [defaultSiteLeadId], references: [id], onDelete: SetNull)
  defaultOpsManagerId Int?
  defaultOpsManager   User? @relation("ClientBuildingDefaultOpsManager", fields: [defaultOpsManagerId], references: [id], onDelete: SetNull)

  // PR-9 — Building-scoped portfolio owner (wins over Client.portfolioOwnerId).
  // Enables per-building junior-admin ownership for large clients like
  // "Eris Property Group" where different admins run different sites.
  portfolioOwnerId Int?
  portfolioOwner   User? @relation("ClientBuildingPortfolioOwner", fields: [portfolioOwnerId], references: [id], onDelete: SetNull)

  quotations Quotation[] @relation("ClientBuildingQuotations")
  orders     Order[]     @relation("ClientBuildingOrders")
  invoices   Invoice[]   @relation("ClientBuildingInvoices")

  pricingMemories ClientPricingMemory[] @relation("ClientBuildingPricingMemories")

  ohsRiskAssessments OhsRiskAssessment[]
  ohsIncidents       OhsIncident[]
  ohsInspections     OhsInspection[]

  @@index([clientId])
  @@index([portfolioOwnerId])
  clientWorkOrders   ClientWorkOrder[] @relation("ClientWorkOrderBuilding")
  siteMappings        ClientWorkOrderSiteMapping[] @relation("SiteMappingBuilding")
}

/// PR-9 — Audit trail for portfolio ownership changes. Every reassignment of a
/// Client or ClientBuilding to a new portfolio owner is logged here so nobody
/// can quietly move accounts around.
model PortfolioOwnershipLog {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  entityType       String // "CLIENT" | "CLIENT_BUILDING"
  clientId         Int?
  clientBuildingId Int?
  fromUserId       Int?
  toUserId         Int?
  actorId          Int
  actor            User     @relation("PortfolioReassignActor", fields: [actorId], references: [id])
  reason           String?
  autoAssigned     Boolean  @default(false)

  @@index([clientId])
  @@index([clientBuildingId])
  @@index([toUserId])
  @@index([createdAt])
}

model LineItemTemplate {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  description   String
  unitPrice     Float
  unitOfMeasure String   @default("Sum")
  category      String?
  isActive      Boolean  @default(true)

  // Pricing Library extensions ─────────────────────────────────────────────
  // Source of the entry: MANUAL = user-saved template (trusted), LEARNED_FROM_QUOTE
  // / LEARNED_FROM_INVOICE = automatically absorbed from approved documents.
  source           String    @default("MANUAL")
  // TM curation flag. Only items the Technical Manager has reviewed become the
  // "Verified" catalog used as the gold-standard reference.
  isVerified       Boolean   @default(false)
  // Cost to company for this line item (for margin floor checks).
  defaultCost      Float     @default(0)
  // Usage statistics so juniors can prefer popular / recently-validated items.
  usageCount       Int       @default(0)
  lastUsedAt       DateTime?
  // Aggregated pricing stats kept in sync by the absorb routine.
  avgUnitPrice     Float?
  minUnitPrice     Float?
  maxUnitPrice     Float?
  // Recent samples (last 20) — [{ price, qty, quoteNumber, customerName, clientId, clientBuildingId, approvedAt, approvedById }]
  priceSamples     Json      @default("[]")
  // Free-form tags for richer search beyond category (e.g. "geyser","plumbing","high-rise")
  tags             String[]  @default([])
  // Last person to approve a quote containing this item (helpful for credit / audit)
  lastApprovedById Int?
  lastApprovedBy   User?     @relation("LineItemTemplateLastApprover", fields: [lastApprovedById], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User? @relation("LineItemTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  clientMemories ClientPricingMemory[] @relation("ClientPricingMemoryCatalog")

  @@index([category])
  @@index([isActive])
  @@index([isVerified])
  @@index([source])
  @@index([lastUsedAt])
}

/// Pricing recall scoped to a specific client / building. Captures "what we
/// usually charge THIS customer for THIS kind of work" so juniors don't have
/// to remember per-client deals.
model ClientPricingMemory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId         Int?
  client           Client?         @relation("ClientPricingMemories", fields: [clientId], references: [id], onDelete: Cascade)
  clientBuildingId Int?
  clientBuilding   ClientBuilding? @relation("ClientBuildingPricingMemories", fields: [clientBuildingId], references: [id], onDelete: Cascade)

  // Normalised description used as the dedupe key (lowercased, collapsed whitespace)
  descriptionKey String
  description    String
  unitOfMeasure  String   @default("Sum")
  lastUnitPrice  Float
  avgUnitPrice   Float
  minUnitPrice   Float
  maxUnitPrice   Float
  usageCount     Int      @default(1)
  lastUsedAt     DateTime @default(now())

  // Optional pointer back to the catalog item for cross-reference.
  catalogItemId Int?
  catalogItem   LineItemTemplate? @relation("ClientPricingMemoryCatalog", fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([clientId, clientBuildingId, descriptionKey])
  @@index([clientId])
  @@index([clientBuildingId])
  @@index([descriptionKey])
}

// ═══════════════════════════════════════════════════════════════════
// AI Quote Studio (Phase A) — QS-grade quoting foundation.
// Models below enable materials + suppliers + labour + BOM breakdown
// so juniors can generate professional quotes with accurate profitability.
// ═══════════════════════════════════════════════════════════════════

/// Physical materials the company uses (paint, cement, cables, fittings…).
/// Distinct from LineItemTemplate: a LineItemTemplate is a *billing* unit
/// ("Paint interior wall — R118/m²"), while a MaterialCatalog entry is a
/// *consumable* with a coverage rate ("Plascon Wall & All 20 L covers 160 m² per coat").
/// Named MaterialCatalog to avoid collision with the legacy per-order Material model.
model MaterialCatalog {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  name        String // "Plascon Wall & All Interior"
  sku         String? // supplier SKU when known
  brand       String? // "Plascon", "Dulux"
  category    String // "PAINT" | "PLASTER" | "CEMENT" | "PLUMBING" | "ELECTRICAL" | "TILES" | "CONSUMABLES" | ...
  description String?

  // How the material is sold: e.g. pack of 20 with unit "L".
  packSize Float  @default(1)
  packUnit String @default("ea") // "L" | "kg" | "m" | "ea" | "m2" | "m3" | "box"

  // Coverage — how much AREA (or length) does one BASE UNIT cover, per coat/pass.
  // e.g. Plascon Wall & All: 8 m² per L per coat  →  coverageRate=8, coverageUnit="m2_per_L"
  coverageRate  Float? // null if not applicable (e.g. a switch, a bolt)
  coverageUnit  String? // "m2_per_L" | "m2_per_kg" | "m_per_ea" | "ea_per_ea"
  coverageNotes String?

  // Default wastage factor to add on top of raw computed qty (0.10 = 10 %).
  wastageFactor Float @default(0.10)

  // Optional: default supplier & price for quick lookup (mirrored from most-recent MaterialSupplierPrice).
  defaultSupplierId Int?
  defaultSupplier   Supplier? @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  lastKnownPrice    Float? // per pack
  lastPricedAt      DateTime?

  hazardous Boolean @default(false)
  msdsUrl   String?

  isActive  Boolean @default(true)
  createdById Int?
  createdBy   User? @relation("MaterialCatalogCreator", fields: [createdById], references: [id], onDelete: SetNull)

  supplierPrices    MaterialSupplierPrice[]  @relation("MaterialPrices")
  taskMaterialUsage WorkTaskMaterialUsage[]
  bomLines          QuotationBOMLine[]

  @@index([category])
  @@index([brand])
  @@index([isActive])
  @@index([name])
}

/// Suppliers we buy materials from.
model Supplier {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  categories  String[] @default([]) // ["PAINT","PLUMBING"]
  contactName String?
  email       String?
  phone       String?
  websiteUrl  String?
  address     String?

  deliveryLeadDays Int   @default(2)
  minOrderValue    Float @default(0)
  deliveryFee      Float @default(0)

  // Where the AI should try to fetch fresh prices from (allow-listed domains).
  priceFeedUrl String?
  priceListLastFetchedAt DateTime?

  isActive Boolean @default(true)

  prices              MaterialSupplierPrice[] @relation("SupplierPrices")
  bomLines            QuotationBOMLine[]
  defaultForMaterials MaterialCatalog[]       @relation("DefaultSupplier")

  @@index([isActive])
}

/// Per-supplier price for a material. Multiple rows per material (one per
/// supplier). fetchedAt lets us badge stale prices in the UI.
model MaterialSupplierPrice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialId Int
  material   MaterialCatalog @relation("MaterialPrices", fields: [materialId], references: [id], onDelete: Cascade)
  supplierId Int
  supplier   Supplier @relation("SupplierPrices", fields: [supplierId], references: [id], onDelete: Cascade)

  unitPrice Float // price per one PACK (Material.packSize × Material.packUnit)
  minQty    Int   @default(1)
  currency  String @default("ZAR")

  sourceUrl String? // page we last fetched from
  fetchedAt DateTime @default(now())
  isVerified Boolean @default(false) // TM manually confirmed
  verifiedById Int?
  verifiedBy   User? @relation("MaterialPriceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt DateTime?

  notes String?

  @@unique([materialId, supplierId])
  @@index([materialId])
  @@index([supplierId])
  @@index([fetchedAt])
}

/// Labour roles with daily / hourly rates the QS engine uses to size labour cost.
model LabourRole {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code String @unique // "ARTISAN_L1" | "ARTISAN_L2" | "ARTISAN_L3" | "HELPER" | "SITE_LEAD" | "PAINTER" | "PLUMBER" | ...
  name String // display name
  description String?

  hourlyRate Float @default(0)
  dailyRate  Float @default(0)

  // Company-side overhead multiplier applied on top of raw wages (PAYE, UIF, tools, PPE).
  overheadMultiplier Float @default(1.25)

  isActive Boolean @default(true)

  bomLines QuotationBOMLine[]

  @@index([code])
}

/// A reusable "how do we build this?" template. Given the task and a quantity
/// (e.g. 120 m²) the BOM sizer produces: materials needed, wastage-adjusted
/// quantities, and labour crew + days required.
model WorkTaskTemplate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String  @unique // "Paint interior wall — 2 coats"
  description   String?
  category      String // "PAINTING" | "PLASTERING" | "TILING" | "ELECTRICAL" | ...
  unitOfMeasure String // "m2" | "m" | "ea" | "Lm" | "m3"

  // Productivity: how many units of work can ONE person complete in ONE day
  // (e.g. one painter paints 60 m² per day, so productionRate = 60).
  productionRate    Float @default(1)
  defaultCrewSize   Int   @default(1)
  // JSON array of { code, count } e.g. [{ code:"PAINTER", count:2 }, { code:"HELPER", count:1 }]
  defaultCrewRoles  Json  @default("[]")

  // Overheads and margins baked into this task (fallback if quote-level not set).
  targetMarginPct   Float @default(0.30) // 30 %
  overheadPct       Float @default(0.05) // 5 %

  isActive Boolean @default(true)
  createdById Int?
  createdBy   User? @relation("WorkTaskTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  materialUsage WorkTaskMaterialUsage[]

  @@index([category])
  @@index([isActive])
}

/// Junction: which materials does a task consume, and how much per unit of work.
/// e.g. "Paint interior wall — 2 coats" consumes 0.22 L Plascon per m² (2 × 0.11).
model WorkTaskMaterialUsage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  taskId     Int
  task       WorkTaskTemplate @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId Int
  material   MaterialCatalog  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // How much of THIS material (in its packUnit terms — L, kg, ea) does ONE unit
  // of the task's unitOfMeasure consume?
  qtyPerUnit Float
  notes      String?

  @@unique([taskId, materialId])
  @@index([taskId])
  @@index([materialId])
}

/// Per-quotation Bill Of Materials line — the cost breakdown the AI produces
/// for each quotation line item. Enables full profitability analysis.
model QuotationBOMLine {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  quotationId Int
  quotation   Quotation @relation("QuotationBOM", fields: [quotationId], references: [id], onDelete: Cascade)

  // Which billing line item does this cost roll up to? (index into Quotation.items JSON, or the QuotationLineItem id)
  quotationLineItemId Int? // pointer to QuotationLineItem when available
  lineItemIndex       Int // 0-based ordering fallback

  kind String // "MATERIAL" | "LABOUR" | "OVERHEAD" | "MARGIN"

  materialId   Int?
  material     MaterialCatalog? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  supplierId   Int?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  labourRoleId Int?
  labourRole   LabourRole?      @relation(fields: [labourRoleId], references: [id], onDelete: SetNull)

  description String // human-readable ("Plascon Wall & All 20L × 3")
  quantity    Float
  unit        String // "L" | "day" | "hour" | "ea" | ...
  unitPrice   Float
  total       Float

  wastagePct Float @default(0)
  notes      String?
  sourceUrl  String? // supplier URL the price came from (for audit)

  @@index([quotationId])
  @@index([quotationLineItemId])
  @@index([kind])
}

model Lead {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  customerName   String
  companyName    String?
  customerEmail  String
  customerPhone  String
  address        String?
  serviceType    String
  description    String
  estimatedValue Float?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  notes          String?

  // Follow-up tracking
  nextFollowUpDate     DateTime?
  followUpAssignedToId Int?
  followUpAssignedTo   User?     @relation("LeadFollowUpAssignee", fields: [followUpAssignedToId], references: [id])

  createdById Int
  createdBy   User @relation("LeadCreator", fields: [createdById], references: [id])

  // Relations
  orders     Order[]
  quotations Quotation[]
}

model Order {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderNumber   String      @unique
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  serviceType   String
  description   String
  notes         String?
  status        OrderStatus @default(PENDING)
  isPaused      Boolean     @default(false)
  pausedAt      DateTime?

  // SLA tracking
  slaHours     Int?
  slaStartedAt DateTime?
  slaDueAt     DateTime?

  assignedToId Int?
  assignedTo   User? @relation("AssignedArtisan", fields: [assignedToId], references: [id])

  // Artisan self-initiated jobs (PR-3) + lost-revenue tracking (PR-2)
  selfInitiated             Boolean           @default(false)
  initiatedById             Int?
  initiatedBy               User?             @relation("OrderInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  clientOrderNumber         String? // PO ref provided by client
  orderNumberStatus         OrderNumberStatus @default(HAS_NUMBER)
  noOrderReason             String? // free-text if PENDING_FROM_CLIENT or NO_ORDER_REQUIRED
  invoicingBlockers         Json? // [{type:"NO_ORDER_NUMBER", since:"..."}]
  invoicingReadyAt          DateTime?
  adminReviewedAt           DateTime?
  adminReviewedById         Int?
  adminReviewedBy           User?             @relation("OrderAdminReviewer", fields: [adminReviewedById], references: [id], onDelete: SetNull)
  selfInitiatedRejected     Boolean           @default(false)
  selfInitiatedRejectReason String?

  // PR-6 — Multi-artisan crew + per-person labour
  joinCode          String?   @unique // 6-digit code for crew to join via mobile
  joinCodeExpiresAt DateTime? // short-lived TTL — code auto-invalidates after this timestamp
  siteLat           Float? // set by first joiner (lead) — used for geofence checks
  siteLng           Float?
  labourBreakdown   Json? // [{ userId, name, minutes, hourlyRate, dailyRate, total }] snapshot at completion

  // PR-7 — Financial reconciliation + TM commission
  salesAgentId       Int?
  salesAgent         User?  @relation("OrderSalesAgent", fields: [salesAgentId], references: [id], onDelete: SetNull)
  salesAgentAmount   Float? // pre-VAT slice of quote allocated to sales agent (not in TM commission base)
  technicalManagerId Int?
  technicalManager   User?  @relation("OrderTechnicalManager", fields: [technicalManagerId], references: [id], onDelete: SetNull)

  // PR-8 F — Site Lead + Ops Manager attribution + optional pre-VAT commission slices
  // + optional time-worked overrides for HOURLY/DAILY commission rules.
  siteLeadId                Int?
  siteLead                  User?     @relation("OrderSiteLead", fields: [siteLeadId], references: [id], onDelete: SetNull)
  siteLeadAmount            Float?
  siteLeadHoursWorked       Float?
  siteLeadDaysWorked        Float?
  opsManagerId              Int?
  opsManager                User?     @relation("OrderOpsManager", fields: [opsManagerId], references: [id], onDelete: SetNull)
  opsManagerAmount          Float?
  opsManagerHoursWorked     Float?
  opsManagerDaysWorked      Float?
  commissionExcluded        Boolean   @default(false)
  commissionExclusionReason String?
  quotedAmountExclVat       Float? // pre-VAT quote override (else computed from quotation / inclusive)
  vatRate                   Float     @default(0.15)
  monthLockedAt             DateTime? // once month-end is locked, no edits to financials
  monthLockedById           Int?
  monthLockedBy             User?     @relation("OrderMonthLocker", fields: [monthLockedById], references: [id], onDelete: SetNull)

  // PR-7b — TM time-worked per order (drives HOURLY / DAILY commission rules)
  tmHoursWorked         Float?
  tmDaysWorked          Float?
  // PR-7b — Sales agent time-worked per order (for HOURLY / DAILY sales-agent rules; rare)
  salesAgentHoursWorked Float?
  salesAgentDaysWorked  Float?

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  quotationId Int?       @unique
  quotation   Quotation? @relation("QuotationOrder", fields: [quotationId], references: [id], onDelete: SetNull)

  // Reusable client linkage (snapshots remain in customerName/Email/Phone/address)
  clientId         Int?
  client           Client?         @relation("ClientOrders", fields: [clientId], references: [id], onDelete: SetNull)
  clientBuildingId Int?
  clientBuilding   ClientBuilding? @relation("ClientBuildingOrders", fields: [clientBuildingId], references: [id], onDelete: SetNull)

  startTime             DateTime?
  endTime               DateTime?
  materialCost          Float     @default(0)
  labourCost            Float     @default(0)
  labourRate            Float?
  callOutFee            Float     @default(0)
  totalCost             Float     @default(0)
  totalMaterialBudget   Float?
  numLabourersNeeded    Int?
  totalLabourCostBudget Float?

  beforePictures          String[]
  afterPictures           String[]
  contractorSlipUrls      String[]  @default([])
  signedJobCardUrl        String?
  clientRepName           String?
  clientRepSignDate       DateTime?
  clientUnavailableToSign Boolean   @default(false)
  // Artisan (technician) signature — SA legal best practice for a job-card is
  // both parties acknowledge completion. Rendered alongside the client
  // signature block on the job-card PDF.
  artisanSignatureUrl     String?
  artisanSignedByName     String?
  artisanSignDate         DateTime?
  signatureRequestToken   String?   @unique
  signatureRequestSentAt  DateTime?
  documents               String[]  @default([])

  // Draft payment fields (persisted so artisan can resume later)
  draftPaymentType  String? // "hourly" or "daily"
  draftHoursWorked  Float?
  draftDaysWorked   Float?
  draftHourlyRate   Float?
  draftDailyRate    Float?
  draftPaymentNotes String?

  // Relations
  materials     Material[]
  jobActivities JobActivity[]
  expenseSlips  ExpenseSlip[]
  invoice       Invoice?
  creditNotes   CreditNote[]
  reviews       Review[]
  sourceEmail   OrderEmailSource?

  ohsRiskAssessments OhsRiskAssessment[]
  ohsIncidents       OhsIncident[]
  ohsToolboxTalks    OhsToolboxTalk[]
  ohsInspections     OhsInspection[]

  // PR-6 — Multi-artisan crew
  crew OrderCrew[]

  // PR-7 — Financial reconciliation + TM commission
  financialAdjustments   OrderFinancialAdjustment[]
  linkedBankTransactions BankTransaction[]          @relation("BankTransactionOrder")

  // PR-8 — Full audit trail of TM assignment changes (who, when, why, source)
  tmAssignmentLogs OrderTmAssignmentLog[] @relation("OrderTmLog")

  // PR-8 E — Full audit trail of Sales Agent assignment changes
  salesAgentAssignmentLogs OrderSalesAgentAssignmentLog[] @relation("OrderSalesAgentLog")

  // PR-8 F — Full audit trail of Site Lead + Ops Manager assignment changes
  siteLeadAssignmentLogs   OrderSiteLeadAssignmentLog[]   @relation("OrderSiteLeadLog")
  opsManagerAssignmentLogs OrderOpsManagerAssignmentLog[] @relation("OrderOpsManagerLog")
  clientWorkOrderId Int?
  clientWorkOrder   ClientWorkOrder? @relation("ClientWorkOrderOrders", fields: [clientWorkOrderId], references: [id], onDelete: SetNull)

  jobCardPdfUrl     String?

  pushedJobCardPdfAt DateTime?
  myBuildingsJobCardTokens MyBuildingsJobCardPublicToken[] @relation("OrderJobCardPublicToken")
}

// PR-8 — Append-only log of every write to Order.technicalManagerId.
// One row per assignment change. Powers the "Attribution history" popover
// in TM statements and answers "why was this order attributed to X?".
model OrderTmAssignmentLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  orderId Int
  order   Order @relation("OrderTmLog", fields: [orderId], references: [id], onDelete: Cascade)

  fromTmId Int?
  fromTm   User? @relation("TmLogFrom", fields: [fromTmId], references: [id], onDelete: SetNull)
  toTmId   Int?
  toTm     User? @relation("TmLogTo", fields: [toTmId], references: [id], onDelete: SetNull)

  // Where the assignment came from. Kept as a String (not enum) so we can add
  // new sources without a migration.
  //   EXPLICIT_INPUT           – admin/agent typed a TM id at create time
  //   ARTISAN_PICKED           – artisan chose TM via TmPicker on job-start / self-initiate
  //   INITIATOR_DEFAULT_TM     – resolved from initiator's defaultTechnicalManagerId
  //   ASSIGNEE_DEFAULT_TM      – resolved from assignee's defaultTechnicalManagerId
  //   QUOTE_OWNER_DEFAULT_TM   – resolved from quotation.assignedTo.defaultTechnicalManagerId
  //   CREW_LEAD                – legacy fallback (OrderCrew role=LEAD)
  //   ADMIN_OVERRIDE           – admin edited via /admin/tm-statements order-detail knob
  //   BACKFILL                 – PR-8 historical backfill job
  //   UNRESOLVABLE_CLEANUP     – admin resolved via /admin/tm-statements/unassigned screen
  source String

  // Who caused the change. Null for automated processes (backfill script).
  actorId Int?
  actor   User? @relation("TmLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  reason String? // free-text (backfill source detail, admin note, etc.)

  @@index([orderId])
  @@index([toTmId])
  @@index([createdAt])
}

// PR-8 E — Append-only log of every write to Order.salesAgentId.
// Parallel to OrderTmAssignmentLog. Powers attribution badges + audit trail
// for sales-agent slices in TM statements.
model OrderSalesAgentAssignmentLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  orderId Int
  order   Order @relation("OrderSalesAgentLog", fields: [orderId], references: [id], onDelete: Cascade)

  fromSalesAgentId Int?
  fromSalesAgent   User? @relation("SalesAgentLogFrom", fields: [fromSalesAgentId], references: [id], onDelete: SetNull)
  toSalesAgentId   Int?
  toSalesAgent     User? @relation("SalesAgentLogTo", fields: [toSalesAgentId], references: [id], onDelete: SetNull)

  // Attribution source. Kept as String (not enum) so we can add sources without a migration.
  //   EXPLICIT_INPUT              – admin/agent typed a sales-agent id at create time
  //   BUILDING_DEFAULT_SALES_AGENT – resolved from ClientBuilding.defaultSalesAgentId
  //   CLIENT_DEFAULT_SALES_AGENT   – resolved from Client.defaultSalesAgentId
  //   ADMIN_OVERRIDE              – admin edited via /admin/tm-statements order-detail knob
  //   BACKFILL                    – PR-8 E historical backfill job
  //   UNRESOLVABLE_CLEANUP        – admin resolved via unassigned-sales-agent cleanup
  source String

  actorId Int?
  actor   User? @relation("SalesAgentLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  reason String?

  @@index([orderId])
  @@index([toSalesAgentId])
  @@index([createdAt])
}

// PR-8 F — Append-only log of every write to Order.siteLeadId.
