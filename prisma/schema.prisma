  rfq     PropertyManagerRFQ?   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  orderId Int?
  order   PropertyManagerOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // lifecycle
  usedAt    DateTime?
  expiresAt DateTime?

  @@index([type])
  @@index([email])
  @@index([rfqId])
  @@index([orderId])
