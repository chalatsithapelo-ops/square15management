  milestoneId      Int?
  milestone        Milestone? @relation(fields: [milestoneId], references: [id])
  hoursWorked      Float?
  daysWorked       Float?
  hourlyRate       Float?
  dailyRate        Float?
  calculatedAmount Float

  status          PaymentRequestStatus @default(PENDING)
  approvedDate    DateTime?
  paidDate        DateTime?
  rejectionReason String?

