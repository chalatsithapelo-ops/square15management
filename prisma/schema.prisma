  building   Building? @relation("BuildingTenantFeedback", fields: [buildingId], references: [id])

  @@index([customerId])
  @@index([propertyManagerId])
  @@index([buildingId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([createdAt])
