model Quotation {
  id                         Int      @id @default(autoincrement())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  quoteNumber                String   @unique
  clientReferenceQuoteNumber String?
  customerName               String
  customerEmail              String
  customerPhone              String
  address                    String
  customerVatNumber          String?

  items                   Json // Array of { description, quantity, unitPrice, total }
  subtotal                Float
  discountPercent         Float     @default(0)
  discountAmount          Float     @default(0)
  tax                     Float     @default(0)
  total                   Float
  // Deposit REQUESTED on the quotation — carried across when the quotation is
  // converted to an invoice so the same up-front payment terms flow through.
  depositRequestedPercent Float     @default(0)
  depositRequestedAmount  Float     @default(0)
  depositDueDate          DateTime?
  companyMaterialCost     Float     @default(0)
  companyLabourCost       Float     @default(0)
  estimatedProfit         Float     @default(0)
  labourRate              Float?
  numPeopleNeeded         Int?
  estimatedDuration       Float?
  durationUnit            String? // 'HOURLY' or 'DAILY'
  quotationLineItems      Json? // Artisan's breakdown of scope and materials

  status             QuotationStatus @default(DRAFT)
  validUntil         DateTime?
  notes              String?
  projectDescription String?
  rejectionReason    String?

  // Workflow fields (similar to Order)
  startTime      DateTime?
  endTime        DateTime?
  materialCost   Float     @default(0)
  beforePictures String[]  @default([])

  assignedToId Int?
  assignedTo   User? @relation("AssignedArtisan", fields: [assignedToId], references: [id])

  createdById Int?
  createdBy   User? @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  // Reusable client linkage (snapshots remain in customerName/Email/Phone/address)
  clientId         Int?
  client           Client?         @relation("ClientQuotations", fields: [clientId], references: [id], onDelete: SetNull)
  clientBuildingId Int?
  clientBuilding   ClientBuilding? @relation("ClientBuildingQuotations", fields: [clientBuildingId], references: [id], onDelete: SetNull)

  pictures     String[]
  measurements String?

  // Relations
  expenseSlips             QuotationExpenseSlip[]
  lineItems                QuotationLineItem[]
  propertyManagerPdfCopies PropertyManagerQuotationPdfCopy[] @relation("QuotationPdfCopies")
  generatedInvoice         Invoice?                          @relation("QuotationInvoice")
  generatedOrder           Order?                            @relation("QuotationOrder")
  emailSource              QuoteEmailSource?
  bomLines                 QuotationBOMLine[]                @relation("QuotationBOM")
}

model QuotationLineItem {
