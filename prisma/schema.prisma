  unitPrice     Float
  total         Float
  unitOfMeasure String   @default("Sum")

  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Invoice {
  id                    Int      @id @default(autoincrement())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  invoiceNumber         String   @unique
  customerName          String
  customerEmail         String
  customerPhone         String
  address               String
  clientReferenceNumber String?
  customerVatNumber     String?

  items                   Json // Array of { description, quantity, unitPrice, total }
  subtotal                Float
  discountPercent         Float     @default(0)
  discountAmount          Float     @default(0)
  tax                     Float     @default(0)
  total                   Float
  // Deposit tracking — running total of deposit payments received from the
  // client. depositAmount reduces the outstanding balance (total - depositAmount).
  // When depositAmount >= total the invoice is auto-transitioned to PAID.
  depositAmount           Float     @default(0)
  depositPaidDate         DateTime?
  depositReference        String?
  // Deposit REQUESTED from the client on the invoice document itself. When
  // depositRequestedPercent > 0 (or depositRequestedAmount > 0) the PDF shows
  // a "Deposit Required" line and a "Balance on Completion" summary so the
  // customer knows how much to pay up-front.
  depositRequestedPercent Float     @default(0)
  depositRequestedAmount  Float     @default(0)
  depositDueDate          DateTime?
  companyMaterialCost     Float     @default(0)
  companyLabourCost       Float     @default(0)
  estimatedProfit         Float     @default(0)

  status             InvoiceStatus @default(DRAFT)
  isDisputed         Boolean       @default(false)
  dueDate            DateTime?
  paidDate           DateTime?
  rejectionReason    String?
  projectDescription String?
  pmApproved         Boolean       @default(false)
  pmApprovedDate     DateTime?

  // Proof-of-payment / remittance attachment (admin-uploaded after marking PAID).
  remittanceUrl          String?
  remittanceFileName     String?
  remittanceUploadedAt   DateTime?
  remittanceUploadedById Int?
  remittanceUploadedBy   User?     @relation("InvoiceRemittanceUploader", fields: [remittanceUploadedById], references: [id], onDelete: SetNull)

  orderId Int?   @unique
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quotationId Int?       @unique
  quotation   Quotation? @relation("QuotationInvoice", fields: [quotationId], references: [id], onDelete: SetNull)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  // Reusable client linkage (snapshots remain in customerName/Email/Phone/address)
  clientId         Int?
  client           Client?         @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: SetNull)
  clientBuildingId Int?
  clientBuilding   ClientBuilding? @relation("ClientBuildingInvoices", fields: [clientBuildingId], references: [id], onDelete: SetNull)

  notes String?

  // Track who created this invoice (essential for portal separation)
  createdById Int?
  createdBy   User? @relation("InvoiceCreator", fields: [createdById], references: [id])

  // Relations
  lineItems   InvoiceLineItem[]
  creditNotes CreditNote[]
  clientWorkOrders  ClientWorkOrder[] @relation("ClientWorkOrderInvoice")
  publicTokens      MyBuildingsInvoicePublicToken[] @relation("InvoicePublicToken")
  debtorReminders DebtorReminderLog[]
}

model CreditNote {
