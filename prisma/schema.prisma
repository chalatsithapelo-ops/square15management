model Asset {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  description   String?
  category      String
  serialNumber  String?
  purchaseDate  DateTime
  purchasePrice Float
  currentValue  Float
  condition     String
  location      String?
  notes         String?
  images        String[]

  // SARS Depreciation / Wear & Tear (Section 11(e))
  usefulLifeYears         Int? // Estimated useful life in years
  residualValue           Float?    @default(0) // Value at end of useful life
  depreciationMethod      String?   @default("STRAIGHT_LINE") // STRAIGHT_LINE or REDUCING_BALANCE
  sarsWearAndTearRate     Float? // SARS wear-and-tear rate percentage (e.g., 20 for 20%)
  accumulatedDepreciation Float?    @default(0) // Total depreciation to date
  lastDepreciationDate    DateTime? // Date of last depreciation calculation

  // Capital vs Revenue classification
  expenditureType String? @default("CAPITAL") // CAPITAL or REVENUE

